# Create a file named `.env` at the same level as this directory

port=5996 # Make this 5998 for beta
SECRET=RANDOMSTRING123
PLUNK_API_KEY=sk_ # Your Plunk API key
RECAPTCHA_SITE_KEY= # reCAPTCHA Enterprise checkbox site key (public)
RECAPTCHA_PROJECT_ID= # Google Cloud project that owns the reCAPTCHA Enterprise key
RECAPTCHA_API_KEY= # Google Cloud API key allowed to call the reCAPTCHA Enterprise API (private)
TEST_EXTENSION_ID= # Optional: unpublished extension ID for local development
DISCORD_TOKEN= # Optional: Graderoomba's bot token, to look up linked Discord names and avatars
