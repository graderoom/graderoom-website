<!doctype html>
<html lang="en-US">
<head>
    <title>Usage Statistics | Graderoom</title>
    <meta name="description" content="Graderoom activity over time: active users, grades synced and users by graduation year.">
    <link rel="icon" href="/public/resources/common/icon-128.png">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Montserrat:500&display=swap">
    <% let theme; %>
    <% if (page === "charts") { %>
        <% const darkThemeNames = _themeConstants.names.dark; %>
        <% const selectedLightTheme = _appearance.lightTheme; %>
        <% const selectedDarkTheme = _appearance.darkTheme; %>
        <% let date = new Date(); %>
        <% let zeroTime = new Date("0/" + date.getHours() + ":" + date.getMinutes()); %>
        <% zeroTime = zeroTime.getTime(); %>
        <% const autoUsesDark = _appearance.mode === "auto" && (((_appearance.darkModeStart < _appearance.darkModeFinish) && ((zeroTime >= _appearance.darkModeStart) && (zeroTime < _appearance.darkModeFinish))) || ((_appearance.darkModeStart > _appearance.darkModeFinish) && ((zeroTime >= _appearance.darkModeStart) || (zeroTime < _appearance.darkModeFinish)))); %>
        <% const activeThemeName = _appearance.mode === "light" ? selectedLightTheme : _appearance.mode === "dark" ? selectedDarkTheme : autoUsesDark || _appearance.mode === "system" ? selectedDarkTheme : selectedLightTheme; %>
        <% theme = darkThemeNames.includes(activeThemeName); %>
        <link id="pageStyle" rel="stylesheet" type="text/css" href="<%= _themeConstants.css[activeThemeName] %>">
    <% } else { %>
        <% theme = false; %>
        <script>(function(){var d=window.matchMedia&&window.matchMedia('(prefers-color-scheme:dark)').matches;window.__dark=d;document.write('<link id="pageStyle" rel="stylesheet" type="text/css" href="/public/css/themes/'+(d?'dark':'light')+'/index.css">')})()</script>
        <noscript><link id="pageStyle" rel="stylesheet" type="text/css" href="/public/css/themes/light/index.css"></noscript>
    <% } %>
    <link rel="stylesheet" type="text/css" href="/public/css/base.css">
    <link rel="stylesheet" type="text/css" href="/public/css/nav.css">
    <link rel="stylesheet" type="text/css" href="/public/css/components.css">
    <link rel="stylesheet" type="text/css" href="/public/css/responsive.css">
    <link id="blur_base" rel="stylesheet" type="text/css" href="/public/css/blur.css"
          <% if (!_appearance.blurEffects) { %>disabled
            <% } %>
    >
    <link id="blur_responsive" rel="stylesheet" type="text/css" href="/public/css/responsive_blur.css"
          <% if (!_appearance.blurEffects) { %>disabled
            <% } %>
    >
    <link id="reduceMotion" rel="stylesheet" type="text/css" href="/public/css/reduce_motion.css"
          <% if (!_appearance.reduceMotion) { %>disabled
            <% } %>
    >
    <link id="fade" rel="stylesheet" type="text/css" href="/public/css/fade.css" disabled>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        .charts-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
            padding: 1rem 0 20px;
        }

        /* responsive.css hides .chart-container on narrow screens, which is meant for the grades page */
        .charts-grid > .chart-container {
            display: block;
            width: auto;
            min-width: 0;
        }

        .chart-box {
            position: relative;
            aspect-ratio: 2;
        }

        /* Not h4/h6: responsive.css shrinks headings on medium screens */
        .chart-title {
            font-size: 1.5rem;
            font-weight: 500;
            line-height: 1.2;
            margin-bottom: 0.4rem;
        }

        .chart-subtitle {
            font-size: 0.95rem;
            margin-bottom: 0.25rem;
        }

        @media (min-width: 900px) {
            .charts-grid {
                grid-template-columns: 1fr 1fr;
            }

            .charts-grid > .wide {
                grid-column: 1 / -1;
            }
        }

        /* Wide screens fit all four charts in one screen: two per row, each sized to half the viewport */
        @media (min-width: 1400px) {
            .container.charts-page {
                max-width: min(1800px, 96vw);
            }

            .charts-grid > .wide {
                grid-column: auto;
            }

            .chart-box {
                aspect-ratio: auto;
                height: max(200px, calc(50vh - 190px));
            }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.24.0/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.5.1/dist/chart.min.js"></script>
    <script src="/public/js/chart_keep_range.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-zoom/1.1.1/chartjs-plugin-zoom.min.js"
            integrity="sha512-NxlWEbNbTV6acWnTsWRLIiwzOw0IwHQOYUCKBiu/NqZ+5jSy7gjMbpYI+/4KvaNuZ1qolbw+Vnd76pbIUYEG8g=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-moment"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>
</head>
<body>

<% if (page === "charts") { %>
    <%- include('../partials/user/navbar.ejs', {theme: theme, page: page}); %>
<script>
    let alerts = <%- JSON.stringify(_alerts); %>;
    setupTutorialPopups();
    function setupTutorialPopups() {
        $(Object.entries(alerts.tutorialStatus).filter(([, k]) => !k).map(([t]) => "#" + t.substring(0, t.length - 4)).join("Popup, ") + "Popup").addClass("always-show");
    }

    function updateTutorial(action) {
        if (window.innerWidth <= 1100) {
            return;
        }
        $.ajax({
                   url: "/UpdateTutorialStatus", type: "POST", async: true, data: {action: action}
               }).done((response) => {
            if (typeof response === "string" && response.startsWith("<!")) {  // If logged out
                $(".session-timeout").show();
                $("body").find("*").not(".session-timeout").remove();
                return;
            }
            alerts.tutorialStatus = JSON.parse(response);
            $("#" + action + "Popup").animate({opacity: 0}, 400, function () {
                $(this).removeClass("always-show").css("opacity", "");
            });
            setupTutorialPopups();
        });
    }

    $(".gotIt").on("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        let id = $(this).parents("span.tutorial-popup")[0].id;
        updateTutorial(id.substring(0, id.length - 5));
    });
</script>
<% } else { %>
    <%- include('../partials/viewer/viewer_navbar.ejs', {theme: theme, page: page}); %>
<% } %>
<div class="container charts-page">
    <div class="charts-grid">
        <div class="chart-container chart wide">
            <div class="chart-title">Activity</div>
            <div class="chart-subtitle" id="user-desc"></div>
            <div class="chart-subtitle" id="curr-logins"></div>
            <div class="chart-tab tab" style="border-radius: 0.5rem">
                <btn id="btn-0" class="tablinks" onclick="setBounds(0, chart)">5D</btn>
                <btn id="btn-1" class="tablinks" onclick="setBounds(1, chart)">1M</btn>
                <btn id="btn-2" class="tablinks active" onclick="setBounds(2, chart)">6M</btn>
                <btn id="btn-3" class="tablinks" onclick="setBounds(3, chart)">YTD</btn>
                <btn id="btn-4" class="tablinks" onclick="setBounds(4, chart)">1Y</btn>
                <btn id="btn-4" class="tablinks" onclick="setBounds(5, chart)">2Y</btn>
                <btn id="btn-4" class="tablinks" onclick="setBounds(6, chart)">MAX</btn>
            </div>
            <button id="reset-zoom-1" style="display:none; position: absolute; right: 0"
                    class="btn btn-sm" onclick="resetZoom(chart); $(this).hide()">Reset
            </button>
            <div class="chart-box"><canvas id="chart"></canvas></div>
        </div>
        <div class="chart-container chart wide">
            <div class="chart-title">Users by graduation year</div>
            <div class="chart-subtitle">Users are graduated in June of each year</div>
            <div class="chart-tab tab" style="border-radius: 0.5rem">
                <btn id="btn-0" class="tablinks" onclick="setBounds(0, gradYearChart)">5D</btn>
                <btn id="btn-1" class="tablinks" onclick="setBounds(1, gradYearChart)">1M</btn>
                <btn id="btn-2" class="tablinks" onclick="setBounds(2, gradYearChart)">6M</btn>
                <btn id="btn-3" class="tablinks" onclick="setBounds(3, gradYearChart)">YTD</btn>
                <btn id="btn-4" class="tablinks" onclick="setBounds(4, gradYearChart)">1Y</btn>
                <btn id="btn-4" class="tablinks active" onclick="setBounds(5, gradYearChart)">2Y</btn>
                <btn id="btn-4" class="tablinks" onclick="setBounds(6, gradYearChart)">MAX</btn>
            </div>
            <button id="reset-zoom0" style="display:none; position: absolute; right: 0"
                    class="btn btn-sm" onclick="resetZoom(gradYearChart); $(this).hide()">Reset
            </button>
            <div class="chart-box"><canvas id="users"></canvas></div>
        </div>
        <div class="chart-container chart">
            <div class="chart-title">Activity by day of the week</div>
            <div class="chart-subtitle" id="weekday-desc"></div>
            <div class="chart-box"><canvas id="chart-weekdays"></canvas></div>
        </div>
        <div class="chart-container chart">
            <div class="chart-title">Grades synced by day of the week</div>
            <div class="chart-subtitle">New assignments all time, dated by the first sync that picked them up</div>
            <div class="chart-box"><canvas id="posted"></canvas></div>
        </div>
    </div>
</div>

<script>
    Chart.defaults.font.size = 12;
    let colors = ["rgba(255, 99, 132, 0.2)", "rgba(255, 159, 64, 0.2)", "rgba(255, 205, 86, 0.2)", "rgba(75, 192, 192, 0.2)", "rgba(54, 162, 235, 0.2)", "rgba(153, 102, 255, 0.2)", "rgba(201, 203, 207, 0.2)"];
    let borders = ["rgb(255, 99, 132)", "rgb(255, 159, 64)", "rgb(255, 205, 86)", "rgb(75, 192, 192)", "rgb(54, 162, 235)", "rgb(153, 102, 255)", "rgb(201, 203, 207)"];


    const THEME_CSS = <%- JSON.stringify(_themeConstants.css) %>;
    const LIGHT_THEME_NAMES = <%- JSON.stringify(_themeConstants.names.light) %>;

    function themeStylesheetFor(themeName) {
        return THEME_CSS[themeName] ?? THEME_CSS.dark;
    }

    function isDarkThemeName(themeName) {
        return !LIGHT_THEME_NAMES.includes(themeName);
    }

    function isDarkThemeStylesheet() {
        return !LIGHT_THEME_NAMES.some(themeName => document.getElementById("pageStyle").getAttribute("href") === THEME_CSS[themeName]);
    }

    <% if (page !== "charts") { %>
    let darkMode = window.__dark;
    if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
            darkMode = e.matches;
            document.getElementById("fade").disabled = false;
            document.getElementById("pageStyle").setAttribute("href", darkMode ? THEME_CSS.dark : THEME_CSS.light);
            applyThemeBackground(darkMode);
            setTimeout(function() { document.getElementById("fade").disabled = true; }, 500);
            setupAllCharts();
        });
    }
    <% } else { %>
    let checkingTheme;
    let mode = appearance.mode;
    let lightTheme = appearance.lightTheme || "light";
    let darkTheme = appearance.darkTheme || "dark";
    let darkModeStart = appearance.darkModeStart ?? null;
    let darkModeFinish = appearance.darkModeFinish ?? null;

    if (mode === "auto" || mode === "system") {
        checkTime();
    }

    function setAutoTheme() {
        let date = new Date();
        let zeroTime = new Date("0/" + date.getHours() + ":" + date.getMinutes());
        if (mode !== "auto" && mode !== "system") {
            if (checkingTheme) {
                clearInterval(checkingTheme);
            }
            return;
        }

        if ((mode === "system" && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) || (mode === "auto" && (((darkModeStart < darkModeFinish) && ((zeroTime >= darkModeStart) && (zeroTime < darkModeFinish)) || ((darkModeStart > darkModeFinish) && ((zeroTime >= darkModeStart) || (zeroTime < darkModeFinish))))))) {
            let oldDarkMode = isDarkThemeStylesheet();
            darkMode = true;
            if (darkMode !== oldDarkMode) {
                document.getElementById("fade").disabled = false;
                document.getElementById("pageStyle").setAttribute("href", themeStylesheetFor(darkTheme));
                if (appearance.blurEffects) {
                }
                $(".navbar-brand img").attr("src", "/public/resources/dark_mode/logo.png");
                $(".navbar").removeClass("navbar-light").addClass("navbar-dark");
                setTimeout(() => {
                    document.getElementById("fade").disabled = true;
                }, 500);
                if (appearance.seasonalEffects) {
                    init = performance.now();
                    if (darkMode === false) {
                        applyThemeBackground(false);
                    } else if (darkMode) {
                        applyThemeBackground(true);
                    }
                }
                setupAllCharts();
            }
        } else {
            let oldDarkMode = isDarkThemeStylesheet();
            darkMode = false;
            if (darkMode !== oldDarkMode) {
                document.getElementById("fade").disabled = false;
                document.getElementById("pageStyle").setAttribute("href", themeStylesheetFor(lightTheme));
                if (appearance.blurEffects) {
                }
                $(".navbar-brand img").attr("src", "/public/resources/light_mode/logo.png");
                $(".navbar").removeClass("navbar-dark").addClass("navbar-light");
                setTimeout(() => {
                    document.getElementById("fade").disabled = true;
                }, 500);
                if (appearance.seasonalEffects) {
                    init = performance.now();
                    if (darkMode === false) {
                        applyThemeBackground(false);
                    } else if (darkMode) {
                        applyThemeBackground(true);
                    }
                }
                setupAllCharts();
            }
        }
    }

    async function checkTime() {
        if (checkingTheme) {
            clearInterval(checkingTheme);
        }
        setAutoTheme();
        checkingTheme = window.setInterval(function () {
            setAutoTheme();
        }, 100);
    }
    <% } %>

    let uniqueVisitData = <%- JSON.stringify(_uniqueVisitData); %>;
    let weeklyActiveData = <%- JSON.stringify(_weeklyActiveData); %>;
    let monthlyActiveData = <%- JSON.stringify(_monthlyActiveData); %>;
    let gradesPostedData = <%- JSON.stringify(_gradesPostedData); %>;
    let userData = <%- JSON.stringify(_userData); %>;


    // Fill in holes
    let series = [uniqueVisitData, weeklyActiveData, monthlyActiveData, userData].filter(d => d.length);
    let minDate = Math.min(...series.map(d => new Date(d[0].x).getTime()));
    let maxDate = Math.max(...series.map(d => new Date(d.slice(-1)[0].x).getTime()));
    fillHoles(uniqueVisitData);
    fillHoles(weeklyActiveData);
    fillHoles(monthlyActiveData);
    fillHoles(userData, true);

    // Days before visits were tracked only have a lower bound, and so does the first tracked day, which
    // tracking started partway through, and any rolling window that reaches back into them. Those parts are drawn dashed
    let visitsTrackedFrom = <%= visitsTrackedFrom %>;
    let accurateFrom = days => new Date(visitsTrackedFrom).setDate(new Date(visitsTrackedFrom).getDate() + days);
    let tracked = (d, days = 1) => new Date(d.x).getTime() >= accurateFrom(days);
    let estimated = (data, days) => data.map(d => ({x: d.x, y: new Date(d.x).getTime() > accurateFrom(days) ? null : d.y}));
    let measured = (data, days) => data.map(d => ({x: d.x, y: tracked(d, days) ? d.y : null}));

    // Active Users on each weekday, all time, split into tracked days and estimated ones
    let weekdayActiveData = Array(7).fill(0);
    let weekdayInferredData = Array(7).fill(0);
    for (let d of uniqueVisitData) {
        (tracked(d) ? weekdayActiveData : weekdayInferredData)[new Date(d.x).getDay()] += d.y;
    }

    let updated = new Date(<%= lastUpdated - 24 * 60 * 60 * 1000 %>);
    let count = <%- JSON.stringify(_loggedInData.data.value) %>;
    $("#user-desc").text(`${Object.values(userData.slice(-1)[0].y).reduce((a, b) => a + b, 0)} total real user(s) as of ${updated.toDateString()}.`);
    $("#curr-logins").text(`${count.uniqueCount} user(s) online now, in ${count.count} tab(s).`);
    let weekdayPostedData = Array(7).fill(0);
    for (let d of gradesPostedData) {
        weekdayPostedData[new Date(d.x).getDay()] += d.y;
    }
    $("#weekday-desc").text(`Active users all time. Days through ${new Date(visitsTrackedFrom).toDateString()} are inferred from logins and syncs`);

    let chart;
    let postedChart;
    let weekdayLoginChart;
    let gradYearChart;

    function fillHoles(data, fillWithPreviousValue=false) {
        if (!data.length) {
            data.push({x: new Date(minDate).toISOString(), y: 0});
        }
        if (new Date(data[0].x).getTime() !== minDate) {
            data.unshift({x: new Date(minDate).toISOString(), y: 0});
        }
        if (new Date(data[data.length - 1].x).getTime() !== maxDate) {
            data.push({x: new Date(maxDate).toISOString(), y: fillWithPreviousValue ? data[data.length - 1].y : 0});
        }
        for (let i = 1; i < data.length; i++) {
            let prevDate = new Date(data[i - 1].x);
            let currDate = new Date(data[i].x);

            let diffInDays = Math.round((currDate.getTime() - prevDate.getTime()) / (24 * 60 * 60 * 1000));

            for (let j = 1; j < diffInDays; j++) {
                data.splice(i + j - 1, 0, {
                    x: new Date(prevDate.getTime() + j * 24 * 60 * 60 * 1000).toISOString(), y: fillWithPreviousValue ? data[i - 1].y : 0
                });
            }

            i += Math.max(diffInDays - 1, 0);
        }
    }

    function resetZoom(_chart) {
        _chart.resetZoom();
    }

    let lineDataset = (label, color, data) => ({
        label: label,
        backgroundColor: "transparent",
        pointBackgroundColor: color,
        pointBorderColor: "transparent",
        borderColor: color,
        data: data,
        cubicInterpolationMode: "monotone",
        spanGaps: false,
        pointRadius: 1,
        borderWidth: 1,
        pointHoverRadius: 3,
        pointHoverBackgroundColor: color,
        pointHoverBorderColor: color,
        pointHoverBorderWidth: 2
    });
    let dataset = [];
    for (let [label, color, data, days] of [["Active Users", "#9b30d9", uniqueVisitData, 1], ["Weekly Active", "#1f4fd1", weeklyActiveData, 7], ["Monthly Active", "green", monthlyActiveData, 30]]) {
        dataset.push(lineDataset(label, color, measured(data, days)));
        dataset.push({...lineDataset(label, color, estimated(data, days)), borderDash: [4, 4]});
    }

    function setupAllCharts() {
        setupChart();
        setupPostedChart();
        setupWeekdayChart();
        setupGradYearChart();
    }

    setupChart();
    function setupChart() {
        chart = setupLineChart("chart", dataset);
    }


    function setupLineChart(id, datasets) {
        let ctx = document.getElementById(id);
        Chart.getChart(ctx)?.destroy();
        let now = Date.now();
        const dayLength = 24 * 60 * 60 * 1000;
        now = (now - (now % dayLength));
        return new Chart(ctx, {
            type: "line", data: {
                datasets: datasets
            }, options: {
                hover: {
                    mode: "index", intersect: false
                }, scales: {
                    xAxis: {
                        type: "time", time: {
                            unit: "month"
                        }, ticks: {
                            color: (isDarkThemeStylesheet() ? "white" : "black"),
                        }, grid: {
                            color: (isDarkThemeStylesheet() ? "#555555" : "#CCCCCC")
                        },
                        max: now,
                        min: now - 183 * dayLength,
                    }, yAxis: {
                        ticks: {
                            color: (isDarkThemeStylesheet() ? "white" : "black"),
                        }, grid: {
                            color: (isDarkThemeStylesheet() ? "#555555" : "#CCCCCC"),
                            drawBorder: false
                        }
                    }
                }, animation: {
                    easing: "easeOutCubic",
                    duration: 250,
                }, responsive: true, maintainAspectRatio: false, plugins: {
                    legend: {
                        display: true, position: "top", labels: {
                            usePointStyle: true,
                            color: (isDarkThemeStylesheet() ? "white" : "black"),
                            boxWidth: 20,
                            filter: function (item, data) {
                                return !item.text.includes("undefined") && data.datasets.findIndex(d => d.label === item.text) === item.datasetIndex;
                            }
                        }, onClick: function (e, item, legend) {
                            let chart = legend.chart;
                            let visible = chart.isDatasetVisible(item.datasetIndex);
                            chart.data.datasets.forEach((d, i) => d.label === item.text && chart.setDatasetVisibility(i, !visible));
                            chart.update();
                        }
                    }, tooltip: {
                        enabled: true, mode: "index", intersect: false, position: "nearest", displayColors: true, caretSize: 10,
                        filter: (item, i, items) => item.parsed.y !== null && items.findIndex(o => o.dataset.label === item.dataset.label && o.parsed.y !== null) === i, callbacks: {
                            title: function (tooltipItems) {
                                return new Date(tooltipItems[0].label).toDateString();
                            },
                            label: item => `${item.dataset.label}${item.dataset.borderDash ? " (inferred)" : ""}: ${item.formattedValue}`
                        }
                    }, zoom: {
                        zoom: {
                            wheel: {
                                enabled: true, speed: 0.05
                            }, pinch: {
                                enabled: true, threshold: 100
                            }, drag: {
                                enabled: true,
                                backgroundColor: "rgba(127, 127, 127, 0.25)"
                            }, mode: "xy", onZoom: ({chart}) => {
                                $(ctx).closest(".chart-container").find("button").show();

                                // Disable hovering to make animation smoother
                                chart.options.hover.mode = null;
                            }, onZoomComplete: ({chart}) => {
                                $(ctx).closest(".chart-container").find("button").show();
                                chart.options.hover.mode = "index";
                            }
                        }
                    }
                }
            }
        });
    }

    setupGradYearChart();
    function setupGradYearChart() {
        let ctx = document.getElementById("users");
        if (gradYearChart) {
            gradYearChart.destroy();
        }
        let now = Date.now();
        const dayLength = 24 * 60 * 60 * 1000;
        now = (now - (now % dayLength));
        let gradData = (["Freshman", "Sophomore", "Junior", "Senior", "Graduate", "Other", "Unknown"]).map((g, i) => {
            return {
                label: g,
                pointBackgroundColor: borders[i],
                pointBorderColor: "transparent",
                spanGaps: false,
                pointRadius: 1,
                pointHoverRadius: 0,
                pointHoverBackgroundColor: borders[i],
                pointHoverBorderColor: borders[i],
                pointHoverBorderWidth: 0,
                backgroundColor: borders[i],
                borderColor: borders[i],
                borderWidth: 1,
                hidden: i > 3,
                data: userData.map(u => {
                    return {
                        x: u.x,
                        y: u.y[g]
                    }
                }),
                fill: true,
            };
        });
        gradYearChart = new Chart(ctx, {
            type: "line", data: {
                datasets: gradData
            }, options: {
                hover: {
                    mode: "index", intersect: false
                }, scales: {
                    xAxis: {
                        type: "time", time: {
                            unit: "month"
                        }, ticks: {
                            color: (isDarkThemeStylesheet() ? "white" : "black"),
                        }, grid: {
                            color: (isDarkThemeStylesheet() ? "#555555" : "#CCCCCC")
                        },
                        max: now,
                        min: now - 732 * dayLength,
                    }, yAxis: {
                        stacked: true,
                        ticks: {
                            color: (isDarkThemeStylesheet() ? "white" : "black"),
                        }, grid: {
                            color: (isDarkThemeStylesheet() ? "#555555" : "#CCCCCC"),
                            drawBorder: false
                        }
                    }
                }, animation: {
                    easing: "easeOutCubic",
                    duration: 250,
                }, responsive: true, maintainAspectRatio: false, plugins: {
                    legend: {
                        display: true, position: "top", labels: {
                            usePointStyle: true,
                            color: (isDarkThemeStylesheet() ? "white" : "black"),
                            boxWidth: 20,
                            filter: function (item) {
                                return !item.text.includes("undefined");
                            }
                        }
                    }, tooltip: {
                        enabled: true, mode: "index", intersect: false, position: "nearest", displayColors: true, caretSize: 10, callbacks: {
                            title: function (tooltipItems) {
                                return new Date(tooltipItems[0].label).toDateString();
                            },
                            footer: function (tooltipItems) {
                                return `${tooltipItems.reduce((a, b) => a + b.parsed.y, 0)} total users`;
                            },
                            label: function (tooltipItem) {
                                if (!tooltipItem.parsed.y) return null;
                                return `${tooltipItem.dataset.label}: ${tooltipItem.parsed.y}`;
                            }
                        }
                    }, zoom: {
                        zoom: {
                            wheel: {
                                enabled: true, speed: 0.05
                            }, pinch: {
                                enabled: true, threshold: 100
                            }, drag: {
                                enabled: true,
                                backgroundColor: "rgba(127, 127, 127, 0.25)"
                            }, mode: "xy", onZoom: ({chart}) => {
                                $("#reset-zoom0").show();

                                // Disable hovering to make animation smoother
                                chart.options.hover.mode = null;
                            }, onZoomComplete: ({chart}) => {
                                $("#reset-zoom0").show();
                                chart.options.hover.mode = "index";
                            }
                        }
                    }
                }
            }
        });
    }

    function setBounds(index, _chart) {
        // 0 is 5 days
        // 1 is 1 month
        // 2 is 6 months
        // 3 is year to date
        // 4 is 1 year
        // 5 is 2 years
        // 6 is max

        // First activate the right buttons
        let btns = $(_chart.canvas).closest(".chart-container").find(".tablinks");
        btns.removeClass("active");
        $(btns[index]).addClass("active");

        // Then, update the chart
        resetZoom(_chart);

        let now = Date.now();
        const dayLength = 24 * 60 * 60 * 1000;
        now = (now - (now % dayLength)); // Get full day

        let min, max, unit;

        switch (index) {
            case 0:
                min = now - 5 * dayLength;
                unit = "day";
                break;
            case 1:
                min = now - 30 * dayLength;
                unit = "week";
                break;
            case 2:
                min = now - 183 * dayLength;
                unit = "month";
                break;
            case 3:
                min = new Date(`1/1/${new Date().getFullYear()}`).getTime();
                max = new Date(`1/1/${new Date().getFullYear() + 1}`).getTime();
                unit = "month";
                break;
            case 4:
                min = now - 366 * dayLength;
                unit = "month";
                break;
            case 5:
                min = now - 732 * dayLength;
                unit = "month";
                break;
            case 6:
                unit = "year";
                break;
        }
        _chart.options.scales.xAxis.min = min;
        _chart.options.scales.xAxis.max = max;
        _chart.options.scales.xAxis.time.unit = unit;
        _chart.options.hover.mode = "index";
        _chart.update(0);

        // Also hide the reset button
        $(_chart.canvas).closest(".chart-container").find("button").hide();
    }

    let barDataset = (label, color, data) => ({
        label: label,
        backgroundColor: colors[color],
        borderColor: borders[color],
        borderWidth: 1,
        data: data
    });

    // Diagonal lines, for bars that are estimated
    let hatch = color => {
        let canvas = document.createElement("canvas");
        canvas.width = canvas.height = 8;
        let ctx = canvas.getContext("2d");
        ctx.strokeStyle = color;
        ctx.globalAlpha = 0.5;
        ctx.beginPath();
        // The corner strokes keep the lines continuous across tiles
        ctx.moveTo(0, 8);
        ctx.lineTo(8, 0);
        ctx.moveTo(-2, 2);
        ctx.lineTo(2, -2);
        ctx.moveTo(6, 10);
        ctx.lineTo(10, 6);
        ctx.stroke();
        return ctx.createPattern(canvas, "repeat");
    };

    // Chart.js 3 can't dash bar borders, so datasets marked dashed get their hatch and outline drawn here
    let dashedBars = {
        id: "dashedBars",
        afterDatasetsDraw(chart) {
            let ctx = chart.ctx;
            let area = chart.chartArea;
            chart.data.datasets.forEach((dataset, i) => {
                let meta = chart.getDatasetMeta(i);
                if (!dataset.dashed || !meta.visible) return;
                ctx.save();
                ctx.beginPath();
                ctx.rect(area.left, area.top, area.right - area.left, area.bottom - area.top);
                ctx.clip();
                ctx.fillStyle = dataset.hatch;
                ctx.strokeStyle = dataset.borderColor;
                ctx.setLineDash([4, 4]);
                for (let bar of meta.data) {
                    let {x, y, base, width} = bar.getProps(["x", "y", "base", "width"]);
                    if (base - y <= 0) continue;
                    ctx.fillRect(x - width / 2, y, width, base - y);
                    ctx.strokeRect(x - width / 2, y, width, base - y);
                }
                ctx.restore();
            });
        }
    };

    setupWeekdayChart();
    function setupWeekdayChart() {
        weekdayLoginChart = setupWeekdayBarChart("chart-weekdays", [
            {...barDataset("Active Users (inferred)", 5, weekdayInferredData), backgroundColor: "transparent", borderWidth: 0, dashed: true, hatch: hatch(borders[5])},
            barDataset("Active Users", 5, weekdayActiveData)
        ]);
    }

    setupPostedChart();
    function setupPostedChart() {
        postedChart = setupWeekdayBarChart("posted", [barDataset("Grades Synced", 1, weekdayPostedData)]);
    }

    function setupWeekdayBarChart(id, datasets) {
        let ctx = document.getElementById(id);
        Chart.getChart(ctx)?.destroy();
        return new Chart(ctx, {
            type: "bar", data: {
                labels: ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"], datasets: datasets
            }, plugins: [dashedBars], options: {
                maintainAspectRatio: false,
                scales: {
                    y: {
                        stacked: true, beginAtZero: true, ticks: {
                            color: (isDarkThemeStylesheet() ? "white" : "black"),
                        }, grid: {
                            color: (isDarkThemeStylesheet() ? "#555555" : "#CCCCCC")
                        }
                    }, x: {
                        stacked: true, ticks: {
                            color: (isDarkThemeStylesheet() ? "white" : "black"),
                        }, grid: {
                            color: (isDarkThemeStylesheet() ? "#555555" : "#CCCCCC")
                        }
                    }
                }, plugins: {
                    legend: {
                        display: true, position: "top", labels: {
                            color: (isDarkThemeStylesheet() ? "white" : "black"),
                            boxWidth: 20,
                            filter: (item, data) => !data.datasets[item.datasetIndex].dashed,
                            generateLabels: chart => Chart.defaults.plugins.legend.labels.generateLabels(chart)
                                .map(label => ({...label, hidden: !!chart.data.datasets[label.datasetIndex].off}))
                        }, onClick: function (e, item, legend) {
                            // Hiding a dataset only fades it in place while the axis jumps, so instead its bars
                            // animate down to 0 and back. Active Users also toggles Active Users (inferred)
                            let chart = legend.chart;
                            let off = !chart.data.datasets[item.datasetIndex].off;
                            for (let d of chart.data.datasets.filter(d => d.label.startsWith(item.text))) {
                                d.full ??= d.data;
                                d.off = off;
                                d.data = off ? d.full.map(() => 0) : d.full;
                            }
                            chart.update();
                        }
                    }, tooltip: {
                        mode: "index", intersect: false,
                        filter: item => item.parsed.y !== 0,
                        callbacks: {
                            footer: items => items.length > 1 ? `Total: ${items.reduce((sum, item) => sum + item.parsed.y, 0)}` : ""
                        }
                    }
                }
            }
        });
    }
</script>
</body>
