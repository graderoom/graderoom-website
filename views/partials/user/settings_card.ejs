<!-- Settings Card -->
<div class="blurred-login" id="settingsCardDisplay">
    <div class="blurred-background"></div>
    <div class="col-sm-11 col-md-10 col-lg-9 col-xl-8 mx-auto">
        <div id="settingsCard" class="card card-signin my-5" style="padding-bottom: 1rem">
            <btn class="btn btn-md"
                 onclick="closeForm('settingsCardDisplay')"
                 style="display: table; width: fit-content; width: -moz-fit-content; margin-bottom:0">
                <i class="fa fa-close" aria-hidden="true"></i> Close
            </btn>
            <div class="card-body">
                <h1 class="card-title text-center popup" style="margin: 0;"><i class="fa fa-cog"></i>
                    Settings
                </h1>
            </div>
            <div class="tab">
                <btn id="btn-0" class="tablinks donate-nav-item" onclick="openTab(0)"><span class="donate"><span
                                class="inner-donate">Donate</span></span>
                </btn>
                <btn id="btn-1" class="tablinks active" onclick="openTab(1)">Appearance</btn>
                <btn id="btn-2" class="tablinks" onclick="openTab(2)">Account</btn>
                <btn id="btn-3" class="tablinks" onclick="openTab(3)">Advanced</btn>
                <btn id="btn-4" class="tablinks" onclick="openTab(4)">Help</btn>
                <btn id="btn-5" class="tablinks" onclick="openTab(5)">About</btn>
                <% if (_betaFeatures.active) { %>
                    <btn id="btn-5" class="tablinks" onclick="openTab(6)">Experiments</btn>
                <% } %>
            </div>
            <div id="settings-0" class="tabcontent">
                <div class="card-body">
                    <div class="card-footer">
                        <h3>What You Get</h3>
                        <p>
                            The goal of Donation-based features is to reward those who support the maintenance of this
                            website.
                            Below is the current list of features that are unlocked by donating.
                            The feature list is subject to change at any time.
                            These features will never affect the core functionality of the site.
                            Scroll down to view donation options.
                        </p>
                        <div id="donationWhatYouGetContainer">
                            <table id="donationWhatYouGet" style="width: 100%">
                                <thead>
                                <tr>
                                    <th>Feature</th>
                                    <th>Free</th>
                                    <th>Donor<br><b>$0.01+</b></th>
                                    <th><span class="plus label-background"><span
                                                    class="plus-label">PLUS</span></span><br><b>$3.00+</b></th>
                                    <th><span class="premium label-background"><span
                                                    class="premium-label">PREMIUM</span></span><br><b>$5.00+</b></th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr>
                                    <th><span>Access class average for latest assignment in each course</span></th>
                                    <td class="supported"></td>
                                    <td class="previous"></td>
                                    <td class="previous"></td>
                                    <td class="previous"></td>
                                </tr>
                                <tr>
                                    <th><span>Get a Donor role on Discord</span></th>
                                    <td></td>
                                    <td class="supported"></td>
                                    <td class="previous"></td>
                                    <td class="previous"></td>
                                </tr>
                                <tr>
                                    <th><span>Maximum Requests per Minute</span></th>
                                    <td class="supported text">30</td>
                                    <td class="supported text">40</td>
                                    <td class="supported text">60</td>
                                    <td class="supported text">100</td>
                                </tr>
                                <tr>
                                    <th><span>Sync Cooldown</span></th>
                                    <td class="supported text">4 hr</td>
                                    <td class="supported text">2 hr</td>
                                    <td class="supported text">1 hr</td>
                                    <td class="supported text">15 min</td>
                                </tr>
                                <tr>
                                    <th><span>Themes</span></th>
                                    <%
                                        const allLight = _themeConstants.names.light;
                                        const allDark = _themeConstants.names.dark;
                                        const freeCount = allLight.filter(t => !_themeConstants.names.paid.includes(t)).length + allDark.filter(t => !_themeConstants.names.paid.includes(t)).length;
                                        const plusCount = freeCount + allLight.filter(t => _themeConstants.names.plus.includes(t)).length + allDark.filter(t => _themeConstants.names.plus.includes(t)).length;
                                        const premiumCount = allLight.length + allDark.length;
                                    %>
                                    <td class="supported text"><%= freeCount %></td>
                                    <td class="previous"></td>
                                    <td class="supported text"><%= plusCount %></td>
                                    <td class="supported text"><%= premiumCount %></td>
                                </tr>
                                <tr>
                                    <th><span>Backgrounds</span></th>
                                    <%
                                        const freeBackgroundCount = _themeConstants.backgrounds.names.free.length;
                                        const plusBackgroundCount = freeBackgroundCount + _themeConstants.backgrounds.names.plus.length;
                                        const premiumBackgroundCount = _themeConstants.backgrounds.names.all.length;
                                    %>
                                    <td class="supported text"><%= freeBackgroundCount %></td>
                                    <td class="previous"></td>
                                    <td class="supported text"><%= plusBackgroundCount %></td>
                                    <td class="supported text"><%= premiumBackgroundCount %></td>
                                </tr>
                                <tr>
                                    <th><span>Ability to set custom class colors</span></th>
                                    <td></td>
                                    <td></td>
                                    <td class="supported"></td>
                                    <td class="previous"></td>
                                </tr>
                                <tr>
                                    <th><span>Bypass the sync queue</span></th>
                                    <td></td>
                                    <td></td>
                                    <td class="supported"></td>
                                    <td class="previous"></td>
                                </tr>
                                <tr>
                                    <th><span>View what other teachers teach a course and how many Graderoom users are in those classes</span>
                                    </th>
                                    <td></td>
                                    <td></td>
                                    <td class="supported"></td>
                                    <td class="supported"></td>
                                </tr>
                                <tr>
                                    <th><span>Access class averages for all assignments</span></th>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td class="supported"></td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer">
                        <h4>Want to support Graderoom?</h4>
                        <p>Graderoom is a free service to make your academic lives less stressful and more fun.
                            You
                            are already showing support just by using this project we made for fun. If you want
                            to go
                            above
                            and
                            beyond, feel free to send us a donation.
                        </p>
                        <span><b>Include your name or username</b> in your donation message, so we can match the donation
                            to your
                            Graderoom account.</span>
                        <span>After donating, it may take some time before your donation is processed and appears in
                            your Graderoom <a href="#" onclick="openTab(2)">Account tab</a>.</span>
                    </div>
                    <div class="donation-container">
                        <div class="card-footer">
                            <div id="venmo"></div>
                            <br>
                            <span>If the QR Code doesn't work, you can <a target="_blank"
                                                                          href="https://account.venmo.com/u/jojejo">Click
                                    Here
                                    for Venmo</a></span>
                        </div>
                        <div class="card-footer">
                            <div id="zelle"></div>
                            <br>
                            <span>If you prefer a different method, feel free to contact me through <a href="#"
                                                                                                       style="display: inline"
                                                                                                       onclick="openTab(4)">the
                                    Help tab</a>.</span>
                        </div>
                        <div class="card-footer">
                            <p>If you would like to use PayPal, use this donate button.
                                <b>PayPal takes a significant cut of any donation you make</b>, and this will be
                                reflected
                                in your actual donation amount. Using one of the other methods is highly preferred.
                            </p>
                            <div id="donate-button-container"
                                 style="margin-top: 20px; display: flex; align-items: center; justify-content: center">
                                <div id="donate-button"></div>
                                <script src="https://www.paypalobjects.com/donate/sdk/donate-sdk.js"
                                        charset="UTF-8"></script>
                                <script>
                                    PayPal.Donation.Button({
                                        env: 'production',
                                        hosted_button_id: 'UGSEZPLL7RLFY',
                                        image: {
                                            src: 'https://www.paypalobjects.com/en_US/i/btn/btn_donateCC_LG.gif',
                                            alt: 'Donate with PayPal button',
                                            title: 'PayPal - The safer, easier way to pay online!'
                                        }
                                    }).render('#donate-button');
                                </script>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer" style="display:none">
                        <h5>Contribute to Graderoom on Github</h5>
                    </div>
                </div>
            </div>
            <div id="settings-1" class="tabcontent show">
                <div class="card-body">
                    <div class="card-footer">
                        <h5>Theme</h5>
                        <div id="theme">
                            <style>
                                #theme .theme-section {
                                    margin-top: 0.55rem;
                                    padding-top: 0.5rem;
                                    border-top: 1px solid var(--clr-border-subtle);
                                }

                                #theme .theme-section:first-of-type {
                                    margin-top: 0;
                                    padding-top: 0;
                                    border-top: 0;
                                }

                                #theme .theme-section h6 {
                                    margin-bottom: 0.25rem;
                                }

                                #theme .theme-control {
                                    max-width: 18rem;
                                }

                                #theme .theme-control select {
                                    width: 100%;
                                }

                                #theme select.theme-control {
                                    width: 100%;
                                    max-width: 18rem;
                                }

                                #theme .theme-radio-row {
                                    display: flex;
                                    flex-wrap: wrap;
                                    gap: 0.35rem 1rem;
                                    align-items: center;
                                }

                                #theme .theme-radio-row label {
                                    margin-bottom: 0;
                                    cursor: pointer;
                                    white-space: nowrap;
                                }

                                #theme .theme-radio-row input {
                                    cursor: inherit;
                                }

                                #theme .theme-radio-option {
                                    display: grid;
                                    gap: 0.1rem;
                                }

                                #theme .theme-radio-hint {
                                    display: block;
                                    margin-left: 1.25rem;
                                    opacity: 0.6;
                                    font-size: 0.65rem;
                                    line-height: 1.1;
                                }

                                #theme .theme-background-section {
                                    margin-top: 0.85rem;
                                    padding-top: 0.75rem;
                                    border-top: 2px solid var(--clr-border-subtle);
                                }
                            </style>
                            <div id="themeMessage"
                                 class="alert alert-success alert-dismissible font-weight-bold"
                                 style="display:none">
                                <div style="display:none" class="sk-chase-mini">
                                    <div class="sk-chase-dot mini"></div>
                                    <div class="sk-chase-dot mini"></div>
                                    <div class="sk-chase-dot mini"></div>
                                    <div class="sk-chase-dot mini"></div>
                                    <div class="sk-chase-dot mini"></div>
                                    <div class="sk-chase-dot mini"></div>
                                </div>
                                <div class="messageTxt"></div>
                                <a class="close" onclick="closeMessage('themeMessage')" aria-label="close">X</a>
                            </div>
                            <% const background = _appearance.background || _appearance.lightBackground || (_appearance.seasonalEffects ? "winter-logo" : "default"); %>
                            <% const plusThemeNames = _themeConstants.names.plus; %>
                            <% const premiumThemeNames = _themeConstants.names.premium; %>
                            <% const plusBackgroundNames = _themeConstants.backgrounds.names.plus; %>
                            <% const premiumBackgroundNames = _themeConstants.backgrounds.names.premium; %>
                            <% const themeLabels = _themeConstants.labels; %>
                            <% const selectedLightTheme = _appearance.lightTheme || (_themeConstants.names.light.includes(_appearance.mode) ? _appearance.mode : "light"); %>
                            <% const selectedDarkTheme = _appearance.darkTheme || (_themeConstants.names.dark.includes(_appearance.mode) ? _appearance.mode : "dark"); %>
                            <% const isAutoMode = _appearance.mode === "auto" || _appearance.mode === "system"; %>
                            <div class="theme-section">
                                <h6>Mode</h6>
                                <div class="theme-radio-row">
                                    <label><input type="radio"
                                                  value="light"
                                                  name="theme"
                                                  onchange="$('#light-theme-options').show();
                                                          $('#dark-theme-options, #automatic-theme-options, #auto-limits-container').hide();
                                                          changeSetting('theme', {mode: 'light'});"
                                        <% if (_appearance.mode === "light") { %> checked
                                                <% } %>
                                        > Light</label>
                                    <label><input type="radio"
                                                  value="dark"
                                                  name="theme"
                                                  onchange="$('#dark-theme-options').show();
                                                          $('#light-theme-options, #automatic-theme-options, #auto-limits-container').hide();
                                                          changeSetting('theme', {mode: 'dark'});"
                                        <% if (_appearance.mode === "dark") { %> checked
                                                <% } %>
                                        > Dark</label>
                                    <label><input type="radio"
                                                  value="auto-mode"
                                                  name="theme"
                                                  onchange="$('#light-theme-options, #dark-theme-options, #automatic-theme-options').show();
                                                          const automaticTheme = $('input[name=automaticTheme]:checked').val() || 'system';
                                                          if (automaticTheme === 'auto') {
                                                              $('#auto-limits-container').show().css('display','flex');
                                                              $('#prefers-color-scheme').hide();
                                                          } else {
                                                              $('#auto-limits-container').hide();
                                                              $('#prefers-color-scheme').show();
                                                          }
                                                          changeSetting('theme', {mode: automaticTheme, darkModeStart: darkModeStart, darkModeFinish: darkModeFinish});"
                                        <% if (isAutoMode) { %> checked
                                                <% } %>
                                        > Automatic</label>
                                </div>
                            </div>
                            <div id="automatic-theme-options" class="theme-section" style="<% if (!isAutoMode) { %>display: none;<% } %>">
                                <h6>Automatic Behavior</h6>
                                <div class="theme-radio-row">
                                    <div class="theme-radio-option">
                                        <label class="disable-when-system-theme-not-supported"><input
                                                type="radio"
                                                value="system"
                                                name="automaticTheme"
                                                onchange="$('#auto-limits-container').hide();
                                                        $('#prefers-color-scheme').show();
                                                        changeSetting('theme', {mode: 'system'});"
                                                <% if (_appearance.mode === "system") { %> checked
                                                <% } %>
                                            > Match System</label>
                                        <span id="prefers-color-scheme"
                                              class="theme-radio-hint"
                                              style="<% if (_appearance.mode !== "system") { %>display: none;<% } %>"></span>
                                        <span class="popup show-when-system-theme-not-supported"><i
                                                    class="fa fa-exclamation-circle"><span
                                                        class="popup-right always-show"
                                                        style="width: 10rem;">Your
                                                    browser does not support this option.</span></i></span>
                                    </div>
                                    <label><input id="customScheduleTheme"
                                                  type="radio"
                                                  value="auto"
                                                  name="automaticTheme"
                                                  onchange="$('#auto-limits-container').show().css('display','flex');
                                                          $('#prefers-color-scheme').hide();
                                                          changeSetting('theme', {mode: 'auto', darkModeStart: darkModeStart, darkModeFinish: darkModeFinish});"
                                            <% if (_appearance.mode === "auto") { %> checked
                                            <% } %>
                                        > Custom Schedule</label>
                                </div>
                                <div id="auto-limits-container"
                                     style="<% if (_appearance.mode !== "auto") { %>display: none;<% } else { %>display: flex;<% } %>font-size: 0.9rem; margin: 0.35rem 0 0; align-items: stretch">
                                    <label class="form-group" id="autoLimits"
                                           style="display: flex; white-space: nowrap;">
                                        <label style="vertical-align: center; width: 8rem" for="darkModeStart">
                                            Dark theme from
                                        </label>
                                        <% let _startDate = new Date(_appearance.darkModeStart);
                                        let _endDate = new Date(_appearance.darkModeFinish); %>
                                        <input id="darkModeStart"
                                               style="padding: 0 0.75rem 0 0.75rem"
                                               type="time"
                                               class="text-center form-control dont-clear" name="darkModeStart"
                                               onchange="darkModeStart = new Date('0/' + $(this).val()).getTime(); changeSetting('theme', {mode: 'auto', darkModeStart: darkModeStart, darkModeFinish: darkModeFinish})"
                                               value="<%= ("0" + _startDate.getHours()).slice(-2) + ":" + ("0" + _startDate.getMinutes()).slice(-2) %>"
                                        >
                                        <label style="margin-left: 0.25rem" for="darkModeFinish">
                                            to
                                        </label>
                                        <input id="darkModeFinish"
                                               style="padding: 0 0.75rem 0 0.75rem;"
                                               type="time"
                                               class="text-center form-control dont-clear" name="darkModeFinish"
                                               onchange="darkModeFinish = new Date('0/' + $(this).val()).getTime(); changeSetting('theme', {mode: 'auto', darkModeStart: darkModeStart, darkModeFinish: darkModeFinish})"
                                               value="<%= ("0" + _endDate.getHours()).slice(-2) + ":" + ("0" + _endDate.getMinutes()).slice(-2) %>"
                                        >
                                    </label>
                                </div>
                            </div>
                            <div class="theme-section theme-background-section">
                                <h6>Background
                                    <span id="backgroundBadge"><% if (premiumBackgroundNames.includes(background)) { %><span class="premium label-background"><span class="premium-label">PREMIUM</span></span><% } else if (plusBackgroundNames.includes(background)) { %><span class="plus label-background"><span class="plus-label">PLUS</span></span><% } %></span>
                                </h6>
                                <div class="theme-control">
                                    <select id="backgroundPreset" class="minimal"
                                            onchange="changeSetting('theme', {mode: appearance.mode, background: this.value})">
                                        <% for (const backgroundValue of _themeConstants.backgrounds.names.all) { %>
                                            <% const isLocked = (premiumBackgroundNames.includes(backgroundValue) && !premium) || (plusBackgroundNames.includes(backgroundValue) && !plus); %>
                                            <% if (!isLocked) { %>
                                            <option value="<%= backgroundValue %>" <% if (background === backgroundValue) { %>selected
                                                    <% } %>>
                                                <%= _themeConstants.backgrounds.labels[backgroundValue] %>
                                            </option>
                                            <% } %>
                                        <% } %>
                                    </select>
                                    <% if (!premium) { %>
                                        <%
                                            const backgroundPlusCount = !plus ? plusBackgroundNames.length : 0;
                                            const backgroundPremiumCount = (!plus ? backgroundPlusCount : 0) + premiumBackgroundNames.length;
                                        %>
                                        <div class="unlock-hint">
                                            <% if (!plus && backgroundPlusCount) { %>Unlock <%= backgroundPlusCount %> more with <span class="plus label-background"><span class="plus-label">PLUS</span></span><% if (backgroundPremiumCount) { %><br><% } %><% } %>
                                            <% if (backgroundPremiumCount) { %>Unlock <%= backgroundPremiumCount %> more with <span class="premium label-background"><span class="premium-label">PREMIUM</span></span><% } %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                            <div id="light-theme-options" class="theme-section" style="<% if (_appearance.mode !== "light" && !isAutoMode) { %>display: none;<% } %>">
                                <h6>Light Theme
                                    <span id="lightThemeBadge"><% if (premiumThemeNames.includes(selectedLightTheme)) { %><span class="premium label-background"><span class="premium-label">PREMIUM</span></span><% } else if (plusThemeNames.includes(selectedLightTheme)) { %><span class="plus label-background"><span class="plus-label">PLUS</span></span><% } %></span>
                                </h6>
                                <div class="theme-control">
                                    <select id="lightThemePreset" class="minimal"
                                            onchange="changeSetting('theme', {mode: appearance.mode, lightTheme: this.value})">
                                        <% for (const themeValue of _themeConstants.names.light) { %>
                                            <% const isLocked = (premiumThemeNames.includes(themeValue) && !premium) || (plusThemeNames.includes(themeValue) && !plus); %>
                                            <% if (!isLocked) { %>
                                            <option value="<%= themeValue %>"
                                                    <% if (selectedLightTheme === themeValue) { %>selected<% } %>>
                                                <%= themeLabels[themeValue] %>
                                            </option>
                                            <% } %>
                                        <% } %>
                                    </select>
                                    <% if (!premium) { %>
                                        <%
                                            const lightPlusCount = !plus ? _themeConstants.names.light.filter(t => plusThemeNames.includes(t)).length : 0;
                                            const lightPremiumCount = (!plus ? lightPlusCount : 0) + _themeConstants.names.light.filter(t => premiumThemeNames.includes(t)).length;
                                        %>
                                        <div class="unlock-hint">
                                            <% if (!plus && lightPlusCount) { %>Unlock <%= lightPlusCount %> more with <span class="plus label-background"><span class="plus-label">PLUS</span></span><% if (lightPremiumCount) { %><br><% } %><% } %>
                                            <% if (lightPremiumCount) { %>Unlock <%= lightPremiumCount %> more with <span class="premium label-background"><span class="premium-label">PREMIUM</span></span><% } %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                            <div id="dark-theme-options" class="theme-section" style="<% if (_appearance.mode !== "dark" && !isAutoMode) { %>display: none;<% } %>">
                                <h6>Dark Theme
                                    <span id="darkThemeBadge"><% if (premiumThemeNames.includes(selectedDarkTheme)) { %><span class="premium label-background"><span class="premium-label">PREMIUM</span></span><% } else if (plusThemeNames.includes(selectedDarkTheme)) { %><span class="plus label-background"><span class="plus-label">PLUS</span></span><% } %></span>
                                </h6>
                                <div class="theme-control">
                                    <select id="darkThemePreset" class="minimal"
                                            onchange="changeSetting('theme', {mode: appearance.mode, darkTheme: this.value})">
                                        <% for (const themeValue of _themeConstants.names.dark) { %>
                                            <% const isLocked = (premiumThemeNames.includes(themeValue) && !premium) || (plusThemeNames.includes(themeValue) && !plus); %>
                                            <% if (!isLocked) { %>
                                            <option value="<%= themeValue %>"
                                                    <% if (selectedDarkTheme === themeValue) { %>selected<% } %>>
                                                <%= themeLabels[themeValue] %>
                                            </option>
                                            <% } %>
                                        <% } %>
                                    </select>
                                    <% if (!premium) { %>
                                        <%
                                            const darkPlusCount = !plus ? _themeConstants.names.dark.filter(t => plusThemeNames.includes(t)).length : 0;
                                            const darkPremiumCount = (!plus ? darkPlusCount : 0) +  _themeConstants.names.dark.filter(t => premiumThemeNames.includes(t)).length;
                                        %>
                                        <div class="unlock-hint">
                                            <% if (!plus && darkPlusCount) { %>Unlock <%= darkPlusCount %> more with <span class="plus label-background"><span class="plus-label">PLUS</span></span><% if (darkPremiumCount) { %><br><% } %><% } %>
                                            <% if (darkPremiumCount) { %>Unlock <%= darkPremiumCount %> more with <span class="premium label-background"><span class="premium-label">PREMIUM</span></span><% } %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <hr>
                        <label class="slider-container disable-in-firefox">
                            <label class="switch">
                                <input
                                        id="blurEffectsToggle"
                                        style="margin: 0; display: flex"
                                        type="checkbox"
                                        name="blurEffects"
                                <% if (_appearance.blurEffects) { %>
                                        checked="checked"
                                        <% } %>
                                        onchange="changeSetting('theme', {mode: appearance.mode, blurEffects: !appearance.blurEffects})"
                                >
                                <span class="slider"></span>
                            </label>
                            <label for="blurEffectsToggle">
                                <span>Enable Blur Effects</span> <span class="popup"><i
                                            class="fa fa-question-circle"><span
                                                class="popup-right-bottom">When enabled, adds blur effects across
                                            the site.
                                        </span></i></span> <span class="popup hide-in-firefox"><i
                                            class="fa fa-exclamation-triangle">
                                        <span class="popup-right-bottom">Causes lag on slower
                                            devices</span></i></span>
                            </label>
                            <span style="margin-left: 0.5rem;" class="popup show-in-firefox"><i
                                        class="fa fa-exclamation-circle"><span
                                            class="popup-right always-show"
                                            style="width: 10rem;">Your
                                        browser does not support these effects.</span></i></span>
                        </label>
                        <label class="slider-container">
                            <label class="switch">
                                <input id="seasonalEffectsToggle" type="checkbox"
                                       name="enableSeasonalEffects"
                                <% if (_appearance.seasonalEffects) { %>
                                       checked
                                        <% } %>
                                       onchange="changeSetting('theme', {mode: appearance.mode, seasonalEffects: !appearance.seasonalEffects})"
                                >
                                <span class="slider"></span>
                            </label>
                            <label for="seasonalEffectsToggle">
                                <span>Enable Seasonal Effects</span> <span class="popup"><i
                                            class="fa fa-question-circle"><span
                                                class="popup-right-bottom">When enabled, adds seasonal effects
                                            across the site.
                                        </span></i></span>
                            </label>
                        </label>
                    </div>
                    <% if (_gradeData.length > 0) { %>
                        <div class="card-footer">
                            <h5>Color Scheme</h5>
                            <div id="color-scheme-picker-container">
                                <div>
                                    <label class="slider-container"
