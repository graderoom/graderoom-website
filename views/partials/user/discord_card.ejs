<div class="blurred-login" id="discordCardDisplay"
     style="">
    <div class="blurred-background"></div>
    <div class="col-sm-8 col-md-7 col-lg-5 mx-auto">
        <div id="discordCard" class="card card-signin my-5">
            <btn class="btn btn-md" onclick="closeForm('discordCardDisplay')"
                 style="display:table; width: fit-content; width: -moz-fit-content; margin-bottom:0">
                <i class="fa fa-close" aria-hidden="true"></i> Close
            </btn>
            <div class="card-body">
                <h1 class="card-title text-center popup" style="margin: 0;"><i class="fa fa-address-book"></i>
                    Discord
                </h1>
                <br>
                <div class="card-footer">
                    <p class="discord-identity">
                        <% if (_discord?.avatar) { %>
                            <img id="discordAvatar" class="discord-avatar discord-avatar-lg"
                                 src="<%= _discord.avatar %>" alt="">
                        <% } %>
                        <span>
                            <b id="discordName"><%= _discord?.name ?? "Linked account" %></b><br>
                            <span class="mono" id="discordID"><%= _discord?.id %></span>
                        </span>
                    </p>
                    <p>If this is not you, or you want to link to a different account, use the button below and restart the verification process in Discord.</p>
                    <p>This will NOT remove roles from the currently linked account, but the account will no longer be able to add more roles.</p>
                    <button class="btn btn-med" onclick="unlinkDiscord()">Unlink Discord Account</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    <% if (_discord) { %>
    // Names and avatars can change
    $(function () {
        $(document).one("click", "#discordCardBtn", function () {
            $.post("/discord-refresh", function (data) {
                discord = data;
                setupDiscord();
            });
        });
    });
    <% } %>

    function unlinkDiscord() {
        $.post("/discord-disconnect", function () {
            discord = null;
            setupDiscord();
            closeForm("discordCardDisplay");
        });
    }
</script>
