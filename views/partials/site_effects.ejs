<%
    const background = _appearance.background;
    const selectedLightTheme = _appearance.lightTheme || "light";
    const selectedDarkTheme = _appearance.darkTheme || "dark";
    const activeThemeName = theme ? selectedDarkTheme : selectedLightTheme;
%>
<style>
    #theme-background {
        z-index: -2;
        position: fixed;
        top: 0;
        width: 100%;
        height: 100%;
    }

    #snow-fall {
        position: fixed;
        z-index: -1;
        top: 0;
    }

    #fps {
        font-family: monospace;
        font-size: 0.7rem;
        pointer-events: none;
        background: rgba(0, 0, 0, 0.6);
        color: white;
    }
</style>
<% if (background !== "default") { %>
<link id="themeBackgroundBaseStyle" rel="stylesheet" type="text/css" href="/public/css/theme_backgrounds.css">
<link id="themeBackgroundStyle" rel="stylesheet" type="text/css"
      href="/theme/background.css?theme=<%= activeThemeName %>&background=<%= background %>">
<% } %>

<div id="theme-background" class="theme-<%= activeThemeName %> background-<%= background %>">
    <canvas id='snow-fall' <% if (!_appearance.seasonalEffects) { %>style="display: none"
            <% } %>
    ></canvas>
</div>
<% const lightsMonth = 11; /* 11 is December */ %>
<% if (_appearance.showFps) { %>
<span style="z-index: 999; position: fixed; bottom: 10px; left: 10px;" id="fps"></span>
<% } %> <% const winterStart = 10; %> <% const winterEnd = 2; %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-dateFormat/1.0/jquery.dateFormat.min.js"></script>
<script>
    const today = new Date();
    const winterStart = <%= winterStart %>; // 10 is November
    const winterEnd = <%= winterEnd %>; // 2 is March
    const timeMultiplier = Math.min((today.getMonth() - winterStart + 12) % 12, (winterEnd - today.getMonth() + 12) % 12) / ((winterEnd - winterStart + 24) % 12);
    const rotationScale = 0.01;
    const speedScale = 0.75 + 0.5 * timeMultiplier;
    const buffer = 10;
    const minSpeed = 0.75 + 0.5 * timeMultiplier;
    const sizeScale = 0.4 + 0.2 * timeMultiplier;
    const scaleFactor = 15;

    let numFlakes;
    let snow = [];
    let canvas = document.getElementById("snow-fall"), $$ = canvas.getContext("2d");
    let screenWidth = canvas.width = window.innerWidth, screenHeight = canvas.height = window.innerHeight;
    let renderNextFrame = true;

    let dynamicDisplayInterval;

    let lightsMonth = <%= lightsMonth; %>;
    let init;
    let started = false;

    let lowFps;

    function activeThemeNameFor(isDark) {
        const pageStyle = document.getElementById("pageStyle");
        const href = pageStyle ? pageStyle.getAttribute("href") : "";
        const themeNames = <%- JSON.stringify(_themeConstants.names.fixed) %>;
        const activeTheme = themeNames.find(themeName => href.includes(`/themes/${themeName}/`));
        if (activeTheme) {
            return activeTheme;
        }
        if (!isDark) {
            return "light";
        }

        return "dark";
    }

    function applyThemeBackground(isDark = typeof darkMode !== "undefined" ? darkMode : (typeof __dark !== "undefined" ? __dark : <%= theme ? "true" : "false" %>)) {
        const themeName = activeThemeNameFor(isDark);
        const background = typeof appearance !== "undefined" ? appearance.background : "<%= background %>";
        const themeClasses = <%- JSON.stringify(_themeConstants.names.fixed.map(themeName => `theme-${themeName}`)) %>;
        const backgroundClasses = <%- JSON.stringify(_themeConstants.backgrounds.names.all.map(backgroundName => `background-${backgroundName}`)) %>;
        $("#theme-background")
            .removeClass(themeClasses.join(" "))
            .removeClass(backgroundClasses.join(" "))
            .addClass(`theme-${themeName} background-${background}`);
        setThemeBackgroundStylesheet(themeName, background);
        setupThemeBackgroundDetails(background);
    }

    function setThemeBackgroundStylesheet(themeName, background) {
        let baseLink = document.getElementById("themeBackgroundBaseStyle");
        let link = document.getElementById("themeBackgroundStyle");
        if (background === "default") {
            if (baseLink) {
                baseLink.remove();
            }
            if (link) {
                link.remove();
            }
            return;
        }

        if (!baseLink) {
            baseLink = document.createElement("link");
            baseLink.id = "themeBackgroundBaseStyle";
            baseLink.rel = "stylesheet";
            baseLink.type = "text/css";
            baseLink.href = "/public/css/theme_backgrounds.css";
            document.head.appendChild(baseLink);
        }

        if (!link) {
            link = document.createElement("link");
            link.id = "themeBackgroundStyle";
            link.rel = "stylesheet";
            link.type = "text/css";
            document.head.appendChild(link);
        }

        const href = `/theme/background.css?theme=${themeName}&background=${background}`;
        if (link.getAttribute("href") !== href) {
            link.setAttribute("href", href);
        }
    }

    function setupThemeBackgroundDetails(background) {
        const layerClass = "theme-background-details";
        const paidBackgrounds = <%- JSON.stringify([..._themeConstants.backgrounds.names.plus, ..._themeConstants.backgrounds.names.premium]) %>;
        const bg = $("#theme-background");
        bg.find(`.${layerClass}`).remove();

        if (!paidBackgrounds.includes(background)) {
            return;
        }
        if (background === "aurora" || background === "nebula" || background === "hologlass") {
            if (background === "nebula") {
                setupNebulaBackgroundVariation(bg[0]);
            } else if (background === "hologlass") {
                setupHologlassBackgroundVariation(bg[0]);
            }
            return;
        }

        const layer = $(`<div class="${layerClass}" aria-hidden="true"></div>`);
        const area = screenWidth * screenHeight;
        const density = background === "nebula" ? 17500 : 18500;
        const count = Math.max(18, Math.min(140, Math.round(area / density)));
        const randomExtra = Math.floor(Math.random() * 12);

        for (let i = 0; i < randomExtra; i++) {
            layer.append(`<span style="display: none"></span>`);
        }

        for (let i = 0; i < count; i++) {
            const x = Math.random() * (screenWidth + 180) - 90;
            const y = Math.random() * (screenHeight + 180) - 90;
            layer.append(`<span style="left: ${x}px; top: ${y}px"></span>`);
        }

        bg.append(layer);
    }

    function setupNebulaBackgroundVariation(element) {
        const randomBetween = (min, max) => min + Math.random() * (max - min);
        const percent = (value) => `${Math.round(value * 10) / 10}%`;
        const seconds = (value) => `${Math.round(value * 10) / 10}s`;
        const degrees = (value) => `${Math.round(value)}deg`;
        const decimal = (value) => `${Math.round(value * 100) / 100}`;
        const positionSet = (basePositions) => basePositions.map(([x, y]) => {
            return `${percent(x + randomBetween(-5, 5))} ${percent(y + randomBetween(-5, 5))}`;
        }).join(", ") + ", center";

        element.style.setProperty("--bg-nebula-field-duration", seconds(randomBetween(28, 44)));
        element.style.setProperty("--bg-nebula-drift-duration", seconds(randomBetween(24, 38)));
        element.style.setProperty("--bg-nebula-color-duration", seconds(randomBetween(14, 26)));
        element.style.setProperty("--bg-nebula-field-delay", seconds(-randomBetween(0, 34)));
        element.style.setProperty("--bg-nebula-drift-delay", seconds(-randomBetween(0, 30)));
        element.style.setProperty("--bg-nebula-color-delay", seconds(-randomBetween(0, 18)));

        element.style.setProperty("--bg-nebula-pos-start", positionSet([[0, 0], [100, 0], [50, 100], [45, 42], [60, 54], [50, 50]]));
        element.style.setProperty("--bg-nebula-pos-end", positionSet([[8, 5], [92, 7], [45, 92], [52, 46], [54, 58], [56, 48]]));

        element.style.setProperty("--bg-nebula-field-hue-start", degrees(randomBetween(-16, 4)));
        element.style.setProperty("--bg-nebula-field-hue-end", degrees(randomBetween(8, 28)));
        element.style.setProperty("--bg-nebula-color-hue-start", degrees(randomBetween(-36, -10)));
        element.style.setProperty("--bg-nebula-color-hue-mid", degrees(randomBetween(8, 30)));
        element.style.setProperty("--bg-nebula-color-hue-end", degrees(randomBetween(30, 62)));

        element.style.setProperty("--bg-nebula-field-saturation-start", decimal(randomBetween(0.95, 1.08)));
        element.style.setProperty("--bg-nebula-field-saturation-end", decimal(randomBetween(1.12, 1.28)));
        element.style.setProperty("--bg-nebula-color-saturation-start", decimal(randomBetween(1.08, 1.34)));
        element.style.setProperty("--bg-nebula-color-saturation-mid", decimal(randomBetween(1.62, 2.05)));
        element.style.setProperty("--bg-nebula-color-saturation-end", decimal(randomBetween(1.28, 1.58)));
    }

    function setupHologlassBackgroundVariation(element) {
        const randomBetween = (min, max) => min + Math.random() * (max - min);
        const percent = (value) => `${Math.round(value * 10) / 10}%`;
        const seconds = (value) => `${Math.round(value * 10) / 10}s`;
        const degrees = (value) => `${Math.round(value)}deg`;
        const decimal = (value) => `${Math.round(value * 100) / 100}`;
        const positionSet = (basePositions) => basePositions.map(([x, y]) => {
            return `${percent(x + randomBetween(-6, 6))} ${percent(y + randomBetween(-6, 6))}`;
        }).join(", ") + ", center";

        element.style.setProperty("--bg-hologlass-field-duration", seconds(randomBetween(34, 54)));
        element.style.setProperty("--bg-hologlass-sheen-duration", seconds(randomBetween(28, 44)));
        element.style.setProperty("--bg-hologlass-color-duration", seconds(randomBetween(18, 32)));
        element.style.setProperty("--bg-hologlass-field-delay", seconds(-randomBetween(0, 38)));
        element.style.setProperty("--bg-hologlass-sheen-delay", seconds(-randomBetween(0, 32)));
        element.style.setProperty("--bg-hologlass-color-delay", seconds(-randomBetween(0, 24)));

        element.style.setProperty("--bg-hologlass-angle-1", degrees(randomBetween(112, 138)));
        element.style.setProperty("--bg-hologlass-angle-2", degrees(randomBetween(46, 74)));
        element.style.setProperty("--bg-hologlass-angle-3", degrees(randomBetween(144, 168)));
        element.style.setProperty("--bg-hologlass-sheen-angle-1", degrees(randomBetween(102, 126)));
        element.style.setProperty("--bg-hologlass-sheen-angle-2", degrees(randomBetween(54, 82)));
        element.style.setProperty("--bg-hologlass-sheen-angle-3", degrees(randomBetween(136, 162)));

        element.style.setProperty("--bg-hologlass-pos-start", positionSet([[0, 0], [100, 0], [55, 100], [46, 48], [52, 50], [50, 50]]));
        element.style.setProperty("--bg-hologlass-pos-end", positionSet([[8, 5], [92, 6], [48, 94], [54, 44], [46, 58], [56, 48]]));

        element.style.setProperty("--bg-hologlass-field-hue-start", degrees(randomBetween(-10, 2)));
        element.style.setProperty("--bg-hologlass-field-hue-end", degrees(randomBetween(10, 30)));
        element.style.setProperty("--bg-hologlass-color-hue-start", degrees(randomBetween(-22, -4)));
        element.style.setProperty("--bg-hologlass-color-hue-end", degrees(randomBetween(12, 38)));
        element.style.setProperty("--bg-hologlass-field-saturation-start", decimal(randomBetween(0.98, 1.08)));
        element.style.setProperty("--bg-hologlass-field-saturation-end", decimal(randomBetween(1.14, 1.34)));
        element.style.setProperty("--bg-hologlass-color-saturation-start", decimal(randomBetween(1.02, 1.16)));
        element.style.setProperty("--bg-hologlass-color-saturation-end", decimal(randomBetween(1.20, 1.46)));
    }

    applyThemeBackground();

    function enableSnow() {
        init = performance.now();
        snow.forEach((flake, index) => delete snow[index]);
        snow = [];
        if (!started) {
            Snowy(true);
        } else {
            started = false;
            Snowy();
        }
        $("#snow-fall").show();
        if (typeof setupLights !== "undefined") {
            setupLights();
        }
        $(".lightrope").show();
    }

    function disableSnow() {
        snow.forEach((flake, index) => delete snow[index]);
        snow = [];
        if (typeof numLights !== "undefined") {
            numLights = undefined;
        }
        $("#snow-fall").hide();
        $(".lightrope").hide();
    }

    function Snowy(start = false) {
        if (started) {
            return;
        }
        started = true;
        let snowEnabled = false;
        let lowPerformance = false;
        if (appearance.seasonalEffects && (today.getMonth() >= winterStart || today.getMonth() < winterEnd)) {
            snowEnabled = true;
            numFlakes = screenWidth / scaleFactor + screenWidth * timeMultiplier / scaleFactor;
            for (let i = 0; i < numFlakes; ++i) {
                let flake = new Flake();
                snow.push(initializeFlake(flake));
            }

            function initializeFlake(flake, initial = true) {
                flake.size = (150 / (20 + Math.random() * 55)) * sizeScale;
                if (initial) {
                    flake.yPos = 2 * Math.random() * (-screenHeight) * Math.log1p(flake.size);
                } else {
                    flake.yPos = Math.random() * (-screenHeight);
                }
                flake.xPos = Math.random() * screenWidth;
                flake.rotation = Math.random() * (Math.PI * 2);
                flake.speed = (Math.pow(flake.size * .8, 2) * .15) * speedScale;
                flake.speed = flake.speed < minSpeed ? minSpeed : flake.speed;
                flake.rotationSpeed = Math.log1p(flake.size * .8) * rotationScale;
                return flake;
            }
        }

        lowFps = 20;
        if (start) {

            init = performance.now();
            let lastCalledTime;
            let fps = 0;
            let _10sTempFps = [];
            let _10sAverage = 0;
            let fpsScale;

            go();

            <% if (_appearance.showFps) { %>
            setInterval(() => {
                if (renderNextFrame) {
                    let fpsDisplay = `LOW LIMIT: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${(lowFps < 100 ? `&nbsp;` : ``) + (lowFps < 10 ? `&nbsp;` : ``) + Math.round(lowFps)}FPS<br>`;
                    fpsDisplay += `&nbsp;&nbsp;10S AVG: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${(Math.round(_10sAverage) < 100 ? `&nbsp;` : ``)}${(Math.round(_10sAverage) < 10 ? `&nbsp;` : ``)}<span ${_10sAverage < lowFps ? "style=\"color: red; font-weight: bold;\"" : ""}>${Math.round(_10sAverage)}FPS</span><br>`;
                    fpsDisplay += `FRAMETIME: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${(Math.round(1000 / fps) < 1000 ? `&nbsp;` : ``) + (Math.round(1000 / fps) < 100 ? `&nbsp;` : ``) + (Math.round(1000 / fps) < 10 ? `&nbsp;` : ``) + Math.round(1000 / fps)}MS<br>`;
                    fpsDisplay += `&nbsp;VIEWPORT: ${screenWidth < 100000 ? `&nbsp;` : ``}${screenWidth < 10000 ? `&nbsp;` : ``}${screenWidth < 1000 ? `&nbsp;` : ``}${screenHeight < 100000 ? `&nbsp;` : ``}${screenHeight < 10000 ? `&nbsp;` : ``}${screenHeight < 1000 ? `&nbsp;` : ``}${screenWidth}x${screenHeight}<br>`;
                    fpsDisplay += `&nbsp;&nbsp;&nbsp;FLAKES: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${snow.length === 0 ? `&nbsp;N/A` : `${snow.length < 1000 ? `&nbsp;` : ``}${snow.length < 100 ? `&nbsp;` : ``}${snow.length}`}<br>`;
                    fpsDisplay += `&nbsp;&nbsp;&nbsp;LIGHTS: ${typeof numLights === "undefined" ? "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;N/A" : `&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${numLights < 1000 ? `&nbsp;` : ``}${numLights < 100 ? `&nbsp;` : ``}${numLights}`}`;
                    $("#fps").html(fpsDisplay);
                }
            }, 1);
            <% } %>

            setInterval(() => {
                if (_10sTempFps.length > 2) {
                    _10sAverage = _10sTempFps.reduce((a, b) => a + b.y, 0) / _10sTempFps.length;
                    _10sTempFps.sort((a, b) => a.x - b.x);
                    _10sTempFps = _10sTempFps.slice(_10sTempFps.findIndex(t => t.x >= performance.now() - 10000));
                    lowFps = Math.min(30, Math.max((lowFps * 999 + _10sAverage / 2) / 1000, lowFps));
                }
            }, 1);

            dynamicDisplayInterval = setInterval(() => {
                if (performance.now() - init < 4000 || !renderNextFrame) {
                    return;
                } // Wait 4 seconds before making fps-based changes
                if (_10sAverage < lowFps) {
                    $("#snow-fall").fadeOut("slow");
                    if (snowEnabled) {
                        $("#performance-issues-messages").prepend($(`<small class="performance-issue alert-danger font-weight-bold">${$.format.date(Date.now(), "MM/dd/yy hh:mm:ss a")} | Snow disabled to improve performance</small>`));
                    }
                    snowEnabled = false;
                } else if (!snowEnabled && (today.getMonth() >= winterStart || today.getMonth() < winterEnd)) {
                    $("#snow-fall").fadeIn("slow");
                    $("#performance-issues-messages").prepend($(`<small class="performance-issue alert-success font-weight-bold">${$.format.date(Date.now(), "MM/dd/yy hh:mm:ss a")} | Snow reenabled</small>`));
                    snowEnabled = true;
                }
                if (_10sAverage < lowFps) {
                    if (!lowPerformance) {
                        $("#performance-issues-messages").prepend($(`<small class="performance-issue alert-danger font-weight-bold">${$.format.date(Date.now(), "MM/dd/yy hh:mm:ss a")} | FPS Dropped below threshold</small>`));
                    }
                    lowPerformance = true;
                } else {
                    if (lowPerformance) {
                        $("#performance-issues-messages").prepend($(`<small class="performance-issue alert-success font-weight-bold">${$.format.date(Date.now(), "MM/dd/yy hh:mm:ss a")} | FPS above threshold</small>`));
                    }
                    lowPerformance = false;
                }
            }, 1000);

            function go(requestAnother = true) {
                if (renderNextFrame) {
                    if (!lastCalledTime) {
                        lastCalledTime = performance.now();
                        fps = 1;
                        _10sTempFps.push({x: performance.now(), y: fps});
                        fpsScale = 1;
                    } else {
                        let delta = (performance.now() - lastCalledTime) / 1000;
                        lastCalledTime = performance.now();
                        fps = 1 / delta;
                        _10sTempFps.push({x: performance.now(), y: fps});
                        fpsScale = fps / 60;
                    }
                    $$.clearRect(0, 0, screenWidth, screenHeight);
                    let flake;
                    for (let i = 0; i < snow.length; i++) {
                        flake = snow[i];
                        flake.rotation += flake.rotationSpeed / fpsScale;
                        flake.rotation = flake.rotation >= Math.PI * 2 ? 0 : flake.rotation;
                        flake.yPos += flake.speed / fpsScale;
                        flake.size = Math.min(Math.max((Math.random() > 0.5 ? 0.99 : 1.01) * flake.size, 1), 4);
                        flake.xPos += Math.sin(flake.rotation) / flake.size / fpsScale;
                        if (flake.xPos > screenWidth + buffer) {
                            flake.xPos = -buffer;
                        }
                        if (flake.xPos < -buffer) {
                            flake.xPos = screenWidth + buffer;
                        }
                        if (flake.yPos > screenHeight + 50) {
                            flake = initializeFlake(flake, false);
                        }
                        flake.draw();
                    }
                    window.requestAnimationFrame(go);
                } else if (requestAnother) {
                    window.requestAnimationFrame(go);
                }
            }

            <% if (!_appearance.animateWhenUnfocused) { %>
            window.addEventListener("blur", stop);
            window.addEventListener("focus", play);
            <% } %>

            function stop() {
                if (today.getMonth() >= winterStart || today.getMonth() < winterEnd) {
                    $("#snow-fall").hide();
                    $("#performance-issues-messages").prepend($(`<small class="performance-issue alert-info font-weight-bold">${$.format.date(Date.now(), "MM/dd/yy hh:mm:ss a")} | Effects disabled by window unfocus</small>`));
                }
                renderNextFrame = false;
                document.getElementById("theme-background").classList.add("bg-paused");
            }

            function play() {
                renderNextFrame = true;
                document.getElementById("theme-background").classList.remove("bg-paused");
                if (today.getMonth() >= winterStart || today.getMonth() < winterEnd) {
                    $("#snow-fall").show();
                    $("#performance-issues-messages").prepend($(`<small class="performance-issue alert-info font-weight-bold">${$.format.date(Date.now(), "MM/dd/yy hh:mm:ss a")} | Effects enabled by window focus</small>`));
                }
            }
        }

        function Flake() {
            this.draw = function () {
                this.gradient = $$.createRadialGradient(this.xPos, this.yPos, 0, this.xPos, this.yPos, this.size);
                this.gradient.addColorStop(0, "rgb(255,255,255)");
                this.gradient.addColorStop(1, "rgba(139,194,255,0.84)");
                $$.moveTo(this.xPos, this.yPos);
                $$.fillStyle = this.gradient;
                $$.beginPath();
                $$.arc(this.xPos, this.yPos, this.size, 0, Math.PI * 2, true);
                $$.fill();
            };
        }
    }

    let _resizeTimer;
    window.addEventListener("resize", function () {
        clearTimeout(_resizeTimer);
        _resizeTimer = setTimeout(() => {
            canvas.width = screenWidth = window.innerWidth;
            canvas.height = screenHeight = window.innerHeight;
            snow.forEach((flake, index) => delete snow[index]);
            snow = [];
            started = false;
            setupThemeBackgroundDetails(typeof appearance !== "undefined" ? appearance.background : "<%= background %>");
            Snowy();
            <% if (new Date().getMonth() === lightsMonth) { %>
            setupLights();
            <% } %>
        }, 400);
    }, false);

</script>

<% if (new Date().getMonth() === lightsMonth) { %>
<%- include('limited_time/christmas_lights.ejs', {theme: theme, page: page}); %>
<% } %>
