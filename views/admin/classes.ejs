<!doctype html>
<html lang="en-US">
<head>
    <title>Graderoom</title>
    <link rel="icon" href="/public/resources/common/icon.png">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Montserrat:500&display=swap">
    <% let theme; %>
    <% const darkThemeNames = _themeConstants.names.dark; %>
    <% const lightThemeNames = _themeConstants.names.light; %>
    <% const selectedLightTheme = _appearance.lightTheme; %>
    <% const selectedDarkTheme = _appearance.darkTheme; %>
    <% let date = new Date(); %>
    <% let zeroTime = new Date("0/" + date.getHours() + ":" + date.getMinutes()); %>
    <% zeroTime = zeroTime.getTime(); %>
    <% const autoUsesDark = _appearance.mode === "auto" && (((_appearance.darkModeStart < _appearance.darkModeFinish) && ((zeroTime >= _appearance.darkModeStart) && (zeroTime < _appearance.darkModeFinish))) || ((_appearance.darkModeStart > _appearance.darkModeFinish) && ((zeroTime >= _appearance.darkModeStart) || (zeroTime < _appearance.darkModeFinish)))); %>
    <% const activeThemeName = _appearance.mode === "light" ? selectedLightTheme : _appearance.mode === "dark" ? selectedDarkTheme : autoUsesDark || _appearance.mode === "system" ? selectedDarkTheme : selectedLightTheme; %>
    <% theme = darkThemeNames.includes(activeThemeName); %>
    <link id="pageStyle" rel="stylesheet" type="text/css" href="<%= _themeConstants.css[activeThemeName] %>">
    <link rel="stylesheet" type="text/css" href="/public/css/base.css">
    <link rel="stylesheet" type="text/css" href="/public/css/nav.css">
    <link rel="stylesheet" type="text/css" href="/public/css/forms.css">
    <link rel="stylesheet" type="text/css" href="/public/css/tables.css">
    <link rel="stylesheet" type="text/css" href="/public/css/layout.css">
    <link rel="stylesheet" type="text/css" href="/public/css/components.css">
    <link rel="stylesheet" type="text/css" href="/public/css/responsive.css">
    <link id="blur_base" rel="stylesheet" type="text/css" href="/public/css/blur.css"
          <% if (!_appearance.blurEffects) { %>disabled
            <% } %>
    >
    <link id="blur_responsive" rel="stylesheet" type="text/css" href="/public/css/responsive_blur.css"
          <% if (!_appearance.blurEffects) { %>disabled
            <% } %>
    >
    <link id="reduceMotion" rel="stylesheet" type="text/css" href="/public/css/reduce_motion.css"
          <% if (!_appearance.reduceMotion) { %>disabled
            <% } %>
    >
    <link id="fade" rel="stylesheet" type="text/css" href="/public/css/fade.css" disabled>
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>

<!-- Admin Navbar -->
<%- include('../partials/admin/admin_navbar.ejs', {theme: theme, page: page}); %>

<!-- Term Switcher -->
<div id="termSwitcher" class="blur">
    <% for (let i = 0; i < _termsAndSemesters.length; i++) { %>
        <div id="<%= _termsAndSemesters[i][0]; %>"
        <% if (term === _termsAndSemesters[i][0]) { %> class="active"
                <% } %>
        >
            <%= _termsAndSemesters[i][0]; %>
            <% for (let j = 0; j < _termsAndSemesters[i][1].length; j++) { %>
                <div onclick="window.location.href='/classes/?school=<%=school%>&term=<%= _termsAndSemesters[i][0]; %>&semester=<%= _termsAndSemesters[i][1][j]; %>'"
                     id="<%= _termsAndSemesters[i][0]; %><%= _termsAndSemesters[i][1][j]; %>"
                <% if (term === _termsAndSemesters[i][0] && semester === _termsAndSemesters[i][1][j]) { %>
                     class="active"
                        <% } %>
                >
                    <%= _termsAndSemesters[i][1][j] %>
                </div>
            <% } %>
        </div>
    <% } %>
</div>

<br>
<!-- Main Screen -->
<div id="weightsCard" class="container" style="border-radius:0.5rem">
    <h5 style="font-size: 1.5rem; text-align:center">
        <select id="school-select" class="minimal" onchange="switchSchool()">
            <% for (let i = 0; i < schools.length; i++) { %>
                <option value="<%= schools[i] %>" <% if (schools[i] === school) { %>selected<% } %>><%= schools[i] %></option>
            <% } %>
        </select> | <%= term %> | <%= semester %> </h5>
    <div id="class-pagination" style="display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 0.5rem 0; flex-wrap: wrap;">
        <span id="classTotalLabel"></span>
        <span class="form-group" style="display: flex; align-items: center; gap: 0.25rem; margin: 0;">
            <input id="classSearchInput" class="form-control" name="classSearch" type="text" placeholder="Search classes..." value="<%= classSearch %>">
        </span>
        <span style="display: flex; align-items: center; gap: 0.25rem;">
            <select id="classCountSelect" class="minimal" onchange="updateClassPage()">
                <% for (let n of [10, 20, 30, 50]) { %>
                    <option value="<%= n %>" <% if (n === classCount) { %>selected<% } %>><%= n %></option>
                <% } %>
            </select>
            per page
        </span>
        <span style="display: flex; align-items: center; gap: 0.25rem;">
            <button id="classPrev" class="btn btn-sm admin" onclick="stepClassPage(-1)">&laquo;</button>
            <select id="classPageSelect" class="minimal" onchange="updateClassPage()"></select>
            of <span id="classMaxPageLabel"></span>
            <button id="classNext" class="btn btn-sm admin" onclick="stepClassPage(1)">&raquo;</button>
        </span>
    </div>
    <div id="classResults">
        <%- include('partials/class_results.ejs'); %>
    </div>
</div>
</body>

<!-- Custom JavaScript -->
<script>
    let classes, catalog;

    let classPage = 1;
    let classMaxPage = 1;

    function readClassData() {
        let data = JSON.parse($("#classDataJson").text());
        classes = data.classData;
        catalog = data.catalogData;
        classPage = data.classPage;
        classMaxPage = data.classMaxPage;
        renderPagination(data);
    }

    // the pagination bar is outside the swapped fragment, so it is redrawn here
    function renderPagination(data) {
        $("#classTotalLabel").text(data.classTotal + (data.classTotal === 1 ? " class" : " classes"));
        $("#classMaxPageLabel").text(data.classMaxPage);
        $("#classCountSelect").val(String(data.classCount));

        let pageSelect = $("#classPageSelect");
        let options = "";
        for (let p = 1; p <= data.classMaxPage; p++) {
            options += `<option value="${p}"${p === data.classPage ? " selected" : ""}>${p}</option>`;
        }
        pageSelect.html(options);

        $("#classPrev").prop("disabled", data.classPage <= 1);
        $("#classNext").prop("disabled", data.classPage >= data.classMaxPage);
    }

    function stepClassPage(delta) {
        goToClassPage(Math.min(Math.max(classPage + delta, 1), classMaxPage));
    }

    readClassData();
    let term = "<%= term %>";
    let semester = "<%= semester %>";

    $("#termSwitcher").addClass("hover");
    setTimeout(() => $("#termSwitcher").removeClass("hover"), 2000);

    let searchTimeout;
    let classesSeq = 0;

    // Swaps just the results fragment. Cancels a pending search first, so a debounce
    // armed before a click can't fire afterwards and throw away the newer request, and
    // ignores any response a newer request has already superseded.
    function navigate(params) {
        clearTimeout(searchTimeout);
        let seq = ++classesSeq;
        let qs = params.toString();
        $("#classResults").css("opacity", "0.5");

        $.get("/classes?" + qs + "&fragment=1").done(function (html) {
            if (seq !== classesSeq) {
                return;
            }
            if (typeof html === "string" && html.startsWith("<!")) { // logged out
                window.location.href = "/classes?" + qs;
                return;
            }
            $("#classResults").html(html);
            readClassData();
            history.pushState({}, "", "/classes?" + qs);
        }).fail(function () {
            if (seq === classesSeq) {
                window.location.href = "/classes?" + qs; // fall back to a full load
            }
        }).always(function () {
            if (seq === classesSeq) {
                $("#classResults").css("opacity", "");
            }
        });
    }

    window.addEventListener("popstate", function () {
        let seq = ++classesSeq;
        $.get("/classes" + window.location.search + (window.location.search ? "&" : "?") + "fragment=1").done(function (html) {
            if (seq !== classesSeq) {
                return;
            }
            $("#classResults").html(html);
            readClassData();
        });
    });

    function buildClassParams() {
        return new URLSearchParams(window.location.search);
    }

    function applySearchParam(params) {
        let search = $("#classSearchInput").val().trim();
        if (search) {
            params.set("classSearch", search);
        } else {
            params.delete("classSearch");
        }
    }

    function switchSchool() {
        clearTimeout(searchTimeout);
        let params = buildClassParams();
        params.set("school", $("#school-select option:selected").val());
        params.delete("classPage");
        params.delete("classSearch");
        window.location.href = "/classes?" + params.toString(); // term switcher is outside the fragment
    }

    function updateClassPage() {
        let params = buildClassParams();
        params.set("classCount", $("#classCountSelect").val());
        params.set("classPage", $("#classPageSelect").val());
        applySearchParam(params);
        navigate(params);
    }

    function goToClassPage(p) {
        let params = buildClassParams();
        params.set("classPage", p);
        navigate(params);
    }

    $("#classSearchInput").on("input", function () {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function () {
            let params = buildClassParams();
            applySearchParam(params);
            params.set("classPage", "1");
            navigate(params);
        }, 500);
    });

    function updateNoWeightsIcon(classIndex) {
        let className = Object.keys(classes)[classIndex];
        let hasAnyWeights = Object.entries(classes[className]).some(([key, val]) =>
            val && typeof val === 'object' && !Array.isArray(val) && val.weights && Object.keys(val.weights).length > 0
        );
        if (hasAnyWeights) {
            $("#noWeightsIcon" + classIndex).hide();
        } else {
            $("#noWeightsIcon" + classIndex).show();
        }
    }

    // TODO restructure! this is not good code
    function ajaxPostWeightsDatabaseForm(classIndex, teacherIndex, suggestionIndex, fieldIDsToClear, messagesDivID, async, isUCForm = false) {
        // Get the form.
        let formID;
        if (suggestionIndex) {
            formID = `#suggestion-${classIndex}-${teacherIndex}-${suggestionIndex}`;
        } else if (isUCForm) {
            formID = "#ucClassType" + classIndex;
        } else {
            formID = "#classTypeForm" + classIndex;
        }
        $(formID).submit(function (event) {
            event.preventDefault();
            event.stopImmediatePropagation();

            let formData;
            let message;
            let formMessagesDiv;

            // Serialize the form data.
            let className = Object.keys(classes)[classIndex];
            let teacherName = null;
            let weights = null;
            let hasWeights = null;
            if (teacherIndex) {
                teacherName = Object.keys(classes[className])[teacherIndex];
                //TODO actually collect has weights
                hasWeights = true;
                weights = {};
                let inputs = $(formID + " input");
                for (let i = 0; i < inputs.length; i += 2) {
                    if (inputs[i].name === "hasWeights") {
                        hasWeights = !inputs[i].checked;
                    } else {
                        weights[$(inputs[i])[0].value] = $(inputs[i + 1])[0].valueAsNumber;
                    }
                }
                formData = {
                    term: term,
                    semester: semester,
                    className: className,
                    teacherName: teacherName,
                    weights: weights,
                    hasWeights: hasWeights
                };
            } else {
                let classType = $(formID).find("select")[0].value.trim();
                formData = {
                    term: term, semester: semester, className: className, classType: classType
                };
            }

            // Get the messages.
            formMessagesDiv = $(messagesDivID);
            message = $(formMessagesDiv).find(".messageTxt");
            $(message).text("");
            $(formMessagesDiv).removeClass("alert-success").removeClass("alert-danger").addClass("alert-info");
            $(formMessagesDiv).find(".sk-chase-mini").show().css("display", "inline-block");
            $(formMessagesDiv).show();

            // Submit the form using AJAX.
            $.ajax({
                       type: "POST", url: $(formID).attr("action"), data: formData, async: async
                   }).done(function (response) {
                if (typeof response === "string" && response.startsWith("<!")) {  // If logged out
                    $(".session-timeout").show();
                    $("body").find("*").not(".session-timeout").remove();
                    return;
                }
                // Make sure that the formMessages div has the alert-success class.
                $(formMessagesDiv).removeClass("alert-danger");
                $(formMessagesDiv).addClass("alert-success");

                // Set the message text.
                setTimeout(function () {
                    $(message).text(response.message);
                    $(formMessagesDiv).find(".sk-chase-mini").hide();
                    // Make sure that the formMessages div has the alert-success class.
                    $(formMessagesDiv).removeClass("alert-info");
                    $(formMessagesDiv).addClass("alert-success");
                }, 500);

                // Show the div.
                $(formMessagesDiv).css("display", "block");

                // Clear fields to clear
                for (let i = 0; i < fieldIDsToClear.length; i++) {
                    $(fieldIDsToClear[i]).val("");
                }

                //Fix Styling
                $(formID + " .form-group .form-control").css("border-color", "unset").addClass("text-view");

                //Update class weight for approved suggestions
                if (teacherIndex && parseInt($(formID).find("suggestionindex").html()) !== -1) {
                    $(`#suggestion-${classIndex}-${teacherIndex}--1`).find(".form-group").slice(0, -1).remove(); //Remove all categories
                    $("#check" + classIndex + teacherIndex + "-1").prop("checked", !hasWeights); //Update hasWeights
                    for (let i = 0; i < Object.keys(weights).length; i++) {
                        addCategory(document.createElement("dummy"), classIndex, teacherIndex, "-1");
                        let approved = $(`#category-${classIndex}-${teacherIndex}--1-${i}`);
                        $(approved.find("input")[0]).val(Object.keys(weights)[i]); //Add Category names
                        $(approved.find("input")[1]).val(Object.values(weights)[i]); //Add category weights
                    }
                    $(`#suggestion-${classIndex}-${teacherIndex}--1 .form-group .form-control`).css("border-color", "unset").addClass("text-view");
                    $(`#suggestion-${classIndex}-${teacherIndex}--1 .formSubmitButton`).hide();
                } else {
                    $(formID + " .formSubmitButton").hide();
                }

                //Remove suggestion
                if (response.suggestion != null) {
                    try {
                        $(`#suggestion-${classIndex}-${teacherIndex}-${response.suggestion}`).remove();
                        //remove Suggestion header if no more suggestions
                        if ($(`#collapse-${classIndex}-${teacherIndex}`).find("form").length <= 1) {
                            $(`#suggestion-header-${classIndex}-${teacherIndex}`).remove();
                        }
                    } catch (error) {
                        console.error(error);
                    }
                }

                if (teacherIndex && weights) {
                    let className = Object.keys(classes)[classIndex];
                    let teacherName = Object.keys(classes[className])[teacherIndex];
                    if (classes[className][teacherName]) {
                        classes[className][teacherName].weights = weights;
                        classes[className][teacherName].hasWeights = hasWeights;
                    }
                    updateNoWeightsIcon(parseInt(classIndex));
                }

            }).fail(function (response) {
                // Make sure that the formMessages div has the alert-danger class
                $(formMessagesDiv).removeClass("alert-success");
                $(formMessagesDiv).addClass("alert-danger");

                // Set the message text.
                if (response.message !== "") {
                    $(message).text(response.message);
                } else {
                    $(message).text("Oops! An error occurred and your message could not be sent.");
                }

                // Show the div.
                $(formMessagesDiv).css("display", "block");

                // Hide loading
                $(formMessagesDiv).find(".sk-chase-mini").hide();
            }).always(function () {
                setTimeout(function () {
                    $(formMessagesDiv).find(".sk-chase-mini").hide();
                }, 500);
            });
        });
    }

    function showSubmitButton(element) {
        $(element).parents("form").find(".formSubmitButton").show();
        $(element).parents("form").find(".alert").removeClass("alert-success").addClass("alert-danger").show().find(".messageTxt").text("Changes not Saved!");
    }

    function addCategory(element, classIndex, teacherIndex, suggestionIndex) {
        if (!(element).hasAttribute("disabled")) {
            let classDiv = `#suggestion-${classIndex}-${teacherIndex}-${suggestionIndex}`;
            let newCategory = $(`
                <div class="form-group" id="category-${classIndex}-${teacherIndex}-${suggestionIndex}-${($($(classDiv)[0].children)[1].children.length - 1)}"
                     style="text-indent: 3rem; display: inline-flex; align-items: flex-end; ${($($(classDiv)[0].children)[1].children.length > 1 ? `margin-left: ${($($($(classDiv)[0].children)[1].children)[1].offsetLeft - $(classDiv)[0].offsetLeft)}px` : "")}">
                    <input size="2" style="font-size: 0.9rem; margin-right: 0 !important; width: fit-content; white-space: nowrap; margin-bottom: 0;" class=" disableable form-control" oninput="this.classList.remove('text-view'); showSubmitButton(this); resizeInput(this);" required>:&nbsp;</input>
                    <input style="margin: 0; border-color: lightcoral!important;" type="number" min="0" step="0.1" class="form-control disableable" oninput="this.classList.remove('text-view'); showSubmitButton(this); ">
                    <span class="fa fa-minus disableable" onclick="removeCategory(this)" style="text-indent: 1rem; color: red; cursor: pointer;"></span>
                </div>
            `);
            $($($(classDiv)[0].children)[1]).append(newCategory);
            showSubmitButton($(classDiv));
        }
    }

    function removeCategory(element) {
        if (!(element).hasAttribute("disabled")) {
            let categoryDiv = $(element).parents(".form-group");
            let classDiv = $(categoryDiv.parents(".collapse")[0]);
            categoryDiv.remove();
            showSubmitButton($(classDiv));
        }
    }

    function resizeInput(element) {
        let size = Math.max(2, $(element).val().length + 1);
        $(element).attr("size", size);
    }

    const THEME_CSS = <%- JSON.stringify(_themeConstants.css) %>;
    const LIGHT_THEME_NAMES = <%- JSON.stringify(_themeConstants.names.light) %>;

    function themeStylesheetFor(themeName) {
        return THEME_CSS[themeName] ?? THEME_CSS.dark;
    }

    function isDarkThemeName(themeName) {
        return !LIGHT_THEME_NAMES.includes(themeName);
    }

    function isDarkThemeStylesheet() {
        return !LIGHT_THEME_NAMES.some(themeName => document.getElementById("pageStyle").getAttribute("href") === THEME_CSS[themeName]);
    }


    let checkingTheme;
    let mode = appearance.mode;
    let lightTheme = appearance.lightTheme || "light";
    let darkTheme = appearance.darkTheme || "dark";
    let darkModeStart = appearance.darkModeStart;
    let darkModeFinish = appearance.darkModeFinish;

    if (mode === "auto" || mode === "system") {
        checkTime();
    }

    function setAutoTheme() {
        let date = new Date();
        let zeroTime = new Date("0/" + date.getHours() + ":" + date.getMinutes());
        if (mode !== "auto" && mode !== "system") {
            if (checkingTheme) {
                clearInterval(checkingTheme);
            }
            return;
        }

        let oldDarkMode = isDarkThemeStylesheet();
        if ((mode === "system" && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) || (mode === "auto" && (((darkModeStart < darkModeFinish) && ((zeroTime >= darkModeStart) && (zeroTime < darkModeFinish)) || ((darkModeStart > darkModeFinish) && ((zeroTime >= darkModeStart) || (zeroTime < darkModeFinish))))))) {
            darkMode = true;
            if (darkMode !== oldDarkMode) {
                document.getElementById("fade").disabled = false;
                document.getElementById("pageStyle").setAttribute("href", themeStylesheetFor(darkTheme));
                $(".navbar-brand img").attr("src", "/public/resources/dark_mode/logo.png");
                $(".navbar").removeClass("navbar-light").addClass("navbar-dark");
                setTimeout(() => {
                    document.getElementById("fade").disabled = true;
                }, 500);
                if (appearance.seasonalEffects) {
                    init = performance.now();
                    if (darkMode === false) {
                        applyThemeBackground(false);
                    } else if (darkMode) {
                        applyThemeBackground(true);
                    }
                }
            }
        } else {
            darkMode = false;
            if (darkMode !== oldDarkMode) {
                document.getElementById("fade").disabled = false;
                document.getElementById("pageStyle").setAttribute("href", themeStylesheetFor(lightTheme));
                $(".navbar-brand img").attr("src", "/public/resources/light_mode/logo.png");
                $(".navbar").removeClass("navbar-dark").addClass("navbar-light");
                setTimeout(() => {
                    document.getElementById("fade").disabled = true;
                }, 500);
                if (appearance.seasonalEffects) {
                    init = performance.now();
                    if (darkMode === false) {
                        applyThemeBackground(false);
                    } else if (darkMode) {
                        applyThemeBackground(true);
                    }
                }
            }
        }
    }

    async function checkTime() {
        if (checkingTheme) {
            clearInterval(checkingTheme);
        }
        setAutoTheme();
        checkingTheme = window.setInterval(function () {
            setAutoTheme();
        }, 100);
    }
</script>
</html>
