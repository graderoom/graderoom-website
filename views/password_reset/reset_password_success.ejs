<!doctype html>
<html lang="en-US">
<head>
    <title>Graderoom</title>
    <link rel="icon" href="/public/resources/common/icon.png">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Montserrat:500&display=swap">
    <% let theme = false; %>
    <script>(function(){var d=window.matchMedia&&window.matchMedia('(prefers-color-scheme:dark)').matches;window.__dark=d;document.write('<link id="pageStyle" rel="stylesheet" type="text/css" href="/public/css/'+(d?'dark':'light')+'_mode.css">')})()</script>
    <noscript><link id="pageStyle" rel="stylesheet" type="text/css" href="/public/css/light_mode.css"></noscript>
    <link rel="stylesheet" type="text/css" href="/public/css/base.css">
    <link rel="stylesheet" type="text/css" href="/public/css/nav.css">
    <link rel="stylesheet" type="text/css" href="/public/css/components.css">
    <link rel="stylesheet" type="text/css" href="/public/css/responsive.css">
    <link id="fade" rel="stylesheet" type="text/css" href="/public/css/fade.css" disabled>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Javascript imports -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>
</head>
<body>

<%- include('../partials/viewer/viewer_navbar.ejs', {theme: theme, page: page}); %>
<div class="container h-100 d-flex justify-content-center">
    <div class="col-sm-10 col-md-9 col-lg-8 col-xl-7">
        <div class="card card-signin my-5">
            <div class="card-body">
                <h1 class="text-center card-title">
                    <i class="fa fa-check" aria-hidden="true"></i> Password changed!
                </h1>

                <div class="text-center">
                    <button  type="submit" onclick="location.href='/'" class="btn btn-default btn-lg">Back to home</button>
                </div>

            </div>
        </div>
    </div>
</div>

</body>

<script>
    let darkMode = window.__dark;

    if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
            darkMode = e.matches;
            document.getElementById("fade").disabled = false;
            document.getElementById("pageStyle").setAttribute("href", "/public/css/" + (darkMode ? "dark" : "light") + "_mode.css");
            applyThemeBackground(darkMode);
            setTimeout(function() { document.getElementById("fade").disabled = true; }, 500);
        });
    }
</script>

</html>


